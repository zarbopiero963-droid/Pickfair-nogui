From e376f2d8368a3b6e7b023a0b3ac3a3b532942cd4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 21:53:46 +0000
Subject: [PATCH] [TASK: trusted-ci-562-c2-required-checks] bk_observe: nessun
 PASS senza step eseguiti, conteggio atteso obbligatorio

Codex su #587 (review sostitutiva, P2): report senza --expect-steps certificava PASS una
build passed con jobs vuoti o col solo launcher. Ora nessuno step eseguito => UNKNOWN e
--expect-steps e' obbligatorio. Test RED->GREEN, mutazione bko_no_steps_pass (bk 4/4),
doc aggiornata.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UP4hJAwjKVqkhz7fdoSSKv
---
 docs/ci_buildkite_observability.md |  4 +++-
 guardrails/mutation_catalog.json   | 12 ++++++++++++
 scripts/ci/bk_observe.py           |  7 ++++---
 tests/scripts/test_bk_observe.py   | 21 +++++++++++++++++++++
 4 files changed, 40 insertions(+), 4 deletions(-)

diff --git a/docs/ci_buildkite_observability.md b/docs/ci_buildkite_observability.md
index 32a5010..2f01e9b 100644
--- a/docs/ci_buildkite_observability.md
+++ b/docs/ci_buildkite_observability.md
@@ -29,7 +29,9 @@
   - la durata non supera il budget.
 - **FAIL (1)** se c'è uno SHA o un intento diverso, una build duplicata, uno step fallito o non eseguito (`canceled`, `skipped`, ecc.), un numero di step sbagliato, un budget superato o una build `failed`/`canceled`. Uno step fallito rende FAIL anche una build ancora in corso.
 - **PENDING (3)** se la build o uno step sono ancora attivi.
-- **UNKNOWN (4)** se una risposta è assente o illeggibile, oppure se mancano i job o i tempi.
+- **UNKNOWN (4)** se una risposta è assente o illeggibile, se mancano i job o i tempi, oppure se la build non ha alcuno step eseguito oltre al launcher.
+
+`--expect-steps` è obbligatorio: senza il numero di step atteso non si certifica la completezza della suite.
 
 Un PENDING o un UNKNOWN non vale mai come PASS. Il verdetto riguarda solo la build indicata e non certifica gli head successivi.
 
diff --git a/guardrails/mutation_catalog.json b/guardrails/mutation_catalog.json
index 43220dd..bbad1da 100644
--- a/guardrails/mutation_catalog.json
+++ b/guardrails/mutation_catalog.json
@@ -7194,6 +7194,18 @@
         "tests/scripts/test_bk_observe.py"
       ],
       "rationale": "PF-562 PR-C2: build duplicate per lo stesso intento non segnalate."
+    },
+    {
+      "id": "bko_no_steps_pass",
+      "module": "scripts.ci.bk_observe",
+      "area": "trusted_dispatcher",
+      "file": "scripts/ci/bk_observe.py",
+      "original": "    elif duration is None or not steps:\n",
+      "mutated": "    elif duration is None:\n",
+      "tests": [
+        "tests/scripts/test_bk_observe.py"
+      ],
+      "rationale": "PF-562 PR-C2 (Codex su #587): build passed senza step eseguiti certificata PASS."
     }
   ]
 }
diff --git a/scripts/ci/bk_observe.py b/scripts/ci/bk_observe.py
index 7d6738c..e7f5c5d 100644
--- a/scripts/ci/bk_observe.py
+++ b/scripts/ci/bk_observe.py
@@ -8,7 +8,7 @@ illeggibile è UNKNOWN, una build in corso è PENDING: mai PASS.
 
   bk_observe.py whoami
   bk_observe.py find      --sha <40 hex> | --intent <pf_intent>
-  bk_observe.py report    --build 31 --sha <40 hex> --intent <pf_intent> [--expect-steps 49] [--budget 7200]
+  bk_observe.py report    --build 31 --sha <40 hex> --intent <pf_intent> --expect-steps 49|52 [--budget 7200]
   bk_observe.py log       --build 31 --step w1-pr-check [--tail 200]
   bk_observe.py artifacts --build 31
 
@@ -144,7 +144,8 @@ def evaluate(build: dict, others: list, sha: str, intent: str, expect_steps: int
         verdict = "PENDING"
     elif problems or state != "passed":
         verdict = "FAIL" if state in {"failed", "canceled", "passed"} else "UNKNOWN"
-    elif duration is None:
+    elif duration is None or not steps:
+        # nessuno step eseguito (elenco vuoto o solo il launcher) non prova niente (Codex su #587)
         verdict = "UNKNOWN"
     else:
         verdict = "PASS"
@@ -231,7 +232,7 @@ def parser() -> argparse.ArgumentParser:
     r.add_argument("--build", type=int, required=True)
     r.add_argument("--sha", required=True)
     r.add_argument("--intent", required=True)
-    r.add_argument("--expect-steps", type=int)
+    r.add_argument("--expect-steps", type=int, required=True)   # completezza della suite: sempre dichiarata
     r.add_argument("--budget", type=int, default=7200)
     lg = sub.add_parser("log")
     lg.add_argument("--build", type=int, required=True)
diff --git a/tests/scripts/test_bk_observe.py b/tests/scripts/test_bk_observe.py
index 5db808a..aceb395 100644
--- a/tests/scripts/test_bk_observe.py
+++ b/tests/scripts/test_bk_observe.py
@@ -194,3 +194,24 @@ def test_a_step_whose_only_attempt_was_retried_still_counts(capsys):
     b = _build()
     b["jobs"][4]["retried"] = True                           # nessun tentativo nuovo: resta quello che c'e'
     assert _report(FakeApi(b)) == 0
+
+
+@pytest.mark.parametrize("jobs", [[], [_step("pf-full-suite-launch")]])
+def test_a_build_with_no_executed_step_is_never_pass(jobs, capsys):
+    """Codex su #587: build `passed` senza step eseguiti (elenco vuoto o solo il launcher) non e' una prova."""
+    b = _build()
+    b["jobs"] = jobs
+    rc = bo.main(["report", "--build", "31", "--sha", SHA, "--intent", INTENT, "--expect-steps", "49"], get=FakeApi(b))
+    assert rc != 0 and "VERDETTO_BUILD = PASS" not in capsys.readouterr().out
+
+
+def test_report_requires_the_expected_step_count():
+    """Senza il numero di step atteso non si certifica la completezza della suite: l'argomento e' obbligatorio."""
+    with pytest.raises(SystemExit):
+        bo.main(["report", "--build", "31", "--sha", SHA, "--intent", INTENT], get=FakeApi(_build()))
+
+
+def test_no_step_build_is_unknown_even_without_a_count_check():
+    b = _build()
+    b["jobs"] = []
+    assert bo.evaluate(b, [b], SHA, INTENT, None, 7200)["verdict"] == "UNKNOWN"
-- 
