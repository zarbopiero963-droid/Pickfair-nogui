 def test_completion_rejects_wrong_branch_and_corrupt_assessment(ledger):
diff --git a/tests/scripts/test_pr_fix_loop_ten_cycles.py b/tests/scripts/test_pr_fix_loop_ten_cycles.py
new file mode 100644
index 0000000..d7c1296
--- /dev/null
+++ b/tests/scripts/test_pr_fix_loop_ten_cycles.py
@@ -0,0 +1,115 @@
+"""PF-MASTER-CERTIFICATION-351 §2 (owner 17/10/2026): estensione del budget del fix loop a 10 cicli per PR.
+
+RED sul cap precedente (5): il sesto ciclo veniva rifiutato. GREEN: cicli 1..10 consentiti, l'undicesimo si ferma
+PRIMA della patch (`NEEDS_MANUAL`, `fix_loop_budget_exhausted`). Verifica anche: conteggio persistente fra
+riaperture del ledger, identita' stabile dei cicli (stesso nome = stessa riga, nessuna duplicazione), nessun reset
+non autorizzato, deroga owner limitata (AT_COUNT=10 => ceiling 11), compatibilita' del file ledger (stesso schema,
+stesso percorso), ripresa dopo un crash fra prenotazione e push, tracciabilita' nei documenti normativi.
+"""
+import argparse
+from pathlib import Path
+
+import pytest
+
+from scripts import pr_automation_controller as controller
+from scripts import pr_fix_loop_policy as policy
+from tests.scripts.test_pr_fix_loop_policy import assessment, begin_push, consume, repair_context
+
+TEN = 10
+
+
+@pytest.fixture
+def ledger(tmp_path):
+    book = policy.FixLoopLedger(tmp_path / "fix_loop.sqlite", "owner/repo", 495)
+    book.initialize(0, "storia attestata: nessun ciclo")
+    return book
+
+
+def test_owner_cap_is_ten_everywhere():
+    assert policy.MAX_FIX_LOOP_ITERATIONS_PER_PR == TEN
+    assert controller._budget_limits()["max_autofix_commits_per_pr"] == TEN
+
+
+def test_cycles_one_through_ten_then_eleven_stops_before_patch(ledger):
+    for number in range(1, TEN + 1):
+        consume(ledger, str(number))
+    assert ledger.status()["completed_count"] == TEN
+    stopped = ledger.reserve("11", assessment("CURRENT_DEFECT"))
+    assert not stopped["allowed"]
+    assert stopped["AUTO_PR_FLOW_STATUS"] == "NEEDS_MANUAL"
+    assert stopped["REASON"] == "fix_loop_budget_exhausted"
+    assert not ledger.authorize("11", current_branch="branch")["allowed"]
+    assert not controller.can_run_safe_autofix(repair_context(ledger, "11"))["allowed"]
+
+
+def test_count_is_persistent_and_never_reset_by_reopen_or_reinitialize(ledger):
+    for number in range(TEN):
+        consume(ledger, str(number))
+    reopened = policy.FixLoopLedger(ledger.path, "owner/repo", 495)
+    reopened.initialize(0, "nuovo head / nuovo agente")
+    assert reopened.status()["completed_count"] == TEN
+    assert not reopened.reserve("again", assessment("CURRENT_DEFECT"))["allowed"]
+
+
+def test_cycle_identity_is_stable_and_not_duplicated(ledger):
+    assert ledger.reserve("c1", assessment("CURRENT_DEFECT"))["allowed"]
+    # la stessa prenotazione ripetuta non consuma un secondo slot
+    ledger.reserve("c1", assessment("CURRENT_DEFECT"))
+    assert ledger.status()["used_slots"] == 1
+    assert begin_push(ledger, "c1")["allowed"]
+    ledger.complete("c1", "head-c1", branch="branch")
+    status = ledger.status()
+    assert status["completed_count"] == 1 and status["used_slots"] == 1
+
+
+def test_crash_between_reservation_and_push_is_recovered_not_duplicated(ledger):
+    assert ledger.reserve("crash", assessment("CURRENT_DEFECT"))["allowed"]
+    # "crash": il processo muore dopo la prenotazione; un nuovo processo riapre il ledger
+    reopened = policy.FixLoopLedger(ledger.path, "owner/repo", 495)
+    status = reopened.status()
+    assert status["allowed"] and status["used_slots"] == 1 and status["reserved_count"] == 1
+    assert begin_push(reopened, "crash")["allowed"]
+    assert reopened.complete("crash", "head-crash", branch="branch")["completed_count"] == 1
+    assert reopened.status()["used_slots"] == 1
+
+
+def test_owner_override_at_ten_enables_exactly_the_eleventh(ledger):
+    for number in range(TEN):
+        consume(ledger, str(number))
+    decision = {"repo": "owner/repo", "pr": 495, "author": "owner", "id": "77",
+                "html_url": "https://github.com/owner/repo/pull/495#issuecomment-77",
+                "body": f"OWNER_FIX_LOOP_OVERRIDE PR=495 ADDITIONAL=1 AT_COUNT={TEN}"}
+    ledger.grant_override(decision)
+    assert ledger.status()["ceiling"] == TEN + 1
+    consume(ledger, "eleven")
+    ledger.grant_override(decision)                      # replay: nessun budget aggiuntivo
+    assert not ledger.reserve("twelve", assessment("CURRENT_DEFECT"))["allowed"]
+
+
+def test_old_override_written_for_the_five_cap_is_rejected(ledger):
+    for number in range(TEN):
+        consume(ledger, str(number))
+    stale = {"repo": "owner/repo", "pr": 495, "author": "owner", "id": "78",
+             "html_url": "https://github.com/owner/repo/pull/495#issuecomment-78",
+             "body": "OWNER_FIX_LOOP_OVERRIDE PR=495 ADDITIONAL=1 AT_COUNT=5"}
+    with pytest.raises(ValueError):
+        ledger.grant_override(stale)
+    assert ledger.status()["ceiling"] == TEN
+
+
+def test_ledger_written_under_the_five_cap_stays_readable(tmp_path):
+    """Compatibilita' del checkpoint: un ledger con 5 cicli completati sotto il vecchio cap resta valido
+    e dispone di 5 cicli residui, senza reset."""
+    book = policy.FixLoopLedger(tmp_path / "old.sqlite", "owner/repo", 512)
+    book.initialize(5, "storico attestato sotto il cap 5: 339cd24, 5b4a589, 21aab95, 4a47ab0, 757869f")
+    status = book.status()
+    assert status["allowed"] and status["completed_count"] == 5 and status["ceiling"] == TEN
+    assert book.reserve("6", assessment("CURRENT_DEFECT"))["allowed"]
+
+
+def test_normative_docs_state_the_ten_cycle_cap():
+    root = Path(__file__).resolve().parents[2]
+    for name in ("AGENTS.md", "CLAUDE.md", "docs/auto_pr_flow_spec.md"):
+        text = (root / name).read_text(encoding="utf-8")
+        assert "MAX_FIX_LOOP_ITERATIONS_PER_PR = 10" in text, name
+        assert "MAX_FIX_LOOP_ITERATIONS_PER_PR = 5" not in text, name
