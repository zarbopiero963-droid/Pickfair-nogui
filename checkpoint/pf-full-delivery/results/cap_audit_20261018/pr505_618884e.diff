+    assert not order_thread.is_alive()
+    assert c.bus.payloads("CMD_QUICK_BET") == []
+    event_key = c.rc.duplication_guard.build_event_key(sig)
+    assert not c.rc.duplication_guard.is_duplicate(event_key)
