@@ -172,3 +172,69 @@ def test_f3_evaluate_guard_blocks_on_unknown_liquidity_only_when_armed():
     assert armed["warning"] is True and armed["shortfall"][0]["reason"] == "LIQUIDITY_UNKNOWN"
