+    @staticmethod
+    def _position_key(payload: Dict[str, Any]) -> tuple:
+        return (str(payload.get("market_id", "")), str(payload.get("selection_id", "")),
+                str(payload.get("side", "")).upper())
+
+    def _hedge_block_reason(self, key: tuple) -> Optional[str]:
+        """Motivo del rifiuto se la posizione ha gia' un cashout non riconciliato, altrimenti None.
+
+        AMBIGUOUS => bloccata finche' il mercato non e' regolato (``on_market_reconciled``) o la
+        posizione non e' riconciliata esplicitamente; hedge piazzato ma non eseguito per intero =>
+        bloccata finche' l'exchange lo riporta ancora fra gli ordini correnti; provider assente o
+        illeggibile => bloccata (fail-closed: un dato mancante non vale «nessun ordine»).
+        """
+        entry = self._active_hedges.get(key)
+        if entry is None:
+            return None
+        state = entry.get("state")
+        if state in ("PENDING", "AMBIGUOUS"):
+            return "cashout_pending_reconciliation"
+        bet_id = str(entry.get("bet_id") or "")
+        provider = self.current_orders_provider
+        if not callable(provider):
+            return f"cashout_order_still_live:{bet_id or 'unknown'}"
+        try:
+            current = provider(key[0]) or []
+            live_ids = {str(o.get("bet_id") or o.get("betId") or "") for o in current if isinstance(o, dict)}
+        except Exception:  # noqa: BLE001 - exchange illeggibile => nessun nuovo hedge
+            return f"cashout_order_still_live:{bet_id or 'unknown'}"
+        if bet_id and bet_id in live_ids:
+            return f"cashout_order_still_live:{bet_id}"
+        self._active_hedges.pop(key, None)       # riconciliato dall'exchange: non piu' fra i correnti
+        return None
+
+    def _record_hedge_outcome(self, key: tuple, result: Dict[str, Any], payload: Dict[str, Any]) -> None:
+        matched = self._as_float(result.get("matched"))
+        stake = self._as_float(payload.get("stake"))
+        with self._hedge_lock:
+            if result.get("order_unknown"):
+                self._active_hedges[key] = {"state": "AMBIGUOUS", "bet_id": result.get("bet_id")}
+            elif result.get("placed") and matched + 1e-9 < stake:
+                self._active_hedges[key] = {"state": "LIVE", "bet_id": result.get("bet_id"), "matched": matched}
+            else:
+                self._active_hedges.pop(key, None)   # eseguito per intero, oppure mai piazzato
+
+    def on_market_reconciled(self, payload: Any) -> None:
+        """Settlement confermato del mercato (``RUNTIME_CLOSE_POSITION``): le posizioni di quel mercato
+        sono riconciliate, gli hedge registrati si sciolgono."""
+        if not isinstance(payload, dict):
+            return
+        market_id = str(payload.get("market_id") or "")
+        if not market_id:
+            return
+        with self._hedge_lock:
+            for key in [k for k in self._active_hedges if k[0] == market_id]:
+                self._active_hedges.pop(key, None)
+
+    def reconcile_position(self, market_id: Any, selection_id: Any, side: Any) -> bool:
+        """Riconciliazione esplicita (operatore/runtime) di una posizione: libera il registro."""
+        key = (str(market_id), str(selection_id), str(side or "").upper())
+        with self._hedge_lock:
+            return self._active_hedges.pop(key, None) is not None
+
+    def active_hedges(self) -> Dict[tuple, Dict[str, Any]]:
+        with self._hedge_lock:
+            return {k: dict(v) for k, v in self._active_hedges.items()}
 
     def on_cmd_execute_cashout(self, payload: Dict[str, Any]) -> None:
         """Esegue un singolo comando di cashout, fail-closed end-to-end."""
