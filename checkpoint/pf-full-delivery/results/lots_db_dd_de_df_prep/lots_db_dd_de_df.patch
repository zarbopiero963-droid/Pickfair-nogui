+    executor.on_cmd_execute_cashout(_cmd_payload(**over))
+    return bus.published[-1]
+
+
+def test_second_cashout_is_refused_while_the_first_is_ambiguous():
+    bus, router = _FakeBus(), _FakeRouter()
+    ex = CashoutExecutor(bus, router, current_orders_provider=lambda market_id: [])
+    topic, _ = _fire(ex, bus, router, _result(placed=False, matched=0.0, unknown=True))
+    assert topic == CASHOUT_FAILED and bus.published[-1][1]["status"] == "AMBIGUOUS"
+    topic, payload = _fire(ex, bus, router, _result(placed=True, matched=4.0))
+    assert topic == CASHOUT_FAILED and payload["reason"] == "cashout_pending_reconciliation" and len(router.calls) == 1
+
+
+def test_second_cashout_is_refused_while_the_first_hedge_is_still_live_on_the_exchange():
+    live = [{"betId": "CB1", "marketId": "1.222"}]
+    bus, router = _FakeBus(), _FakeRouter()
+    ex = CashoutExecutor(bus, router, current_orders_provider=lambda market_id: list(live))
+    _fire(ex, bus, router, _result(placed=True, matched=0.0))                     # UNMATCHED, ordine vivo
+    topic, payload = _fire(ex, bus, router, _result(placed=True, matched=4.0))
+    assert topic == CASHOUT_FAILED and payload["reason"] == "cashout_order_still_live:CB1" and len(router.calls) == 1
+    live.clear()                                                                # annullato/regolato sull'exchange
+    topic, _ = _fire(ex, bus, router, _result(placed=True, matched=4.0))
+    assert topic == CASHOUT_SUCCESS and len(router.calls) == 2
+
+
+def test_fully_executed_or_rejected_cashout_frees_the_position():
+    bus, router = _FakeBus(), _FakeRouter()
+    ex = CashoutExecutor(bus, router, current_orders_provider=lambda market_id: [])
+    _fire(ex, bus, router, _result(placed=True, matched=4.0))                     # eseguito per intero
+    _fire(ex, bus, router, _result(placed=False, matched=0.0, error="BET_REJECTED"))
+    topic, _ = _fire(ex, bus, router, _result(placed=True, matched=4.0))
+    assert topic == CASHOUT_SUCCESS and len(router.calls) == 3
+
+
+def test_without_current_orders_provider_a_live_hedge_blocks_fail_closed():
+    bus, router = _FakeBus(), _FakeRouter()
+    ex = CashoutExecutor(bus, router)
+    _fire(ex, bus, router, _result(placed=True, matched=1.0))                     # parziale: residuo vivo
+    topic, payload = _fire(ex, bus, router, _result(placed=True, matched=4.0))
+    assert topic == CASHOUT_FAILED and payload["reason"].startswith("cashout_order_still_live") and len(router.calls) == 1
+
+
+def test_market_settlement_reconciles_an_ambiguous_cashout():
+    bus, router = _FakeBus(), _FakeRouter()
+    ex = CashoutExecutor(bus, router, current_orders_provider=lambda market_id: [])
+    ex.wire()
+    _fire(ex, bus, router, _result(placed=False, matched=0.0, unknown=True))
+    handlers = dict(bus.subscriptions)
+    handlers["RUNTIME_CLOSE_POSITION"]({"market_id": "1.222"})
+    topic, _ = _fire(ex, bus, router, _result(placed=True, matched=4.0))
+    assert topic == CASHOUT_SUCCESS and len(router.calls) == 2
+
