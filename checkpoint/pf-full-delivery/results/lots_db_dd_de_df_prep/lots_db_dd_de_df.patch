+# ---------------------------------------------------------------- hardening (Sol c.6248273030, THEORETICAL): check+reserve
+# atomici per ref nel coordinatore: due execute concorrenti sullo stesso ref non possono entrambe vedere
+# «riserva nuova» e, su store illeggibile, sciogliere la riserva dell'altra.
+def test_concurrent_execute_on_the_same_ref_never_releases_the_shared_reservation():
+    """Deterministico: `has_reservation` trattiene il primo chiamante finche' anche il secondo non e' dentro
+    (barriera). Senza check+reserve atomici entrambi leggono "nessuna riserva"; il secondo, su store illeggibile,
+    scioglie la riserva del primo mentre questo sta per inviare. Con il lock del coordinatore il secondo non puo'
+    entrare finche' il primo non ha riservato (la barriera scade) e vede la riserva preesistente."""
+    import threading
+    gate = threading.Barrier(2, timeout=0.5)
+    a_may_continue = threading.Event()
+    lock = threading.Lock()
+    calls = []
+
+    class _Exchange(StatefulExchangeSimulator):
+        def has_reservation(self, customer_ref):
+            value = super().has_reservation(customer_ref)   # lettura PRIMA della barriera: valore stantio
+            try:
+                gate.wait()
+            except threading.BrokenBarrierError:
+                pass
+            return value
+
+    class _Store(_MemStore):
+        def load(self, ref):
+            with lock:
+                calls.append(threading.current_thread().name)
+                first = len(calls) == 1
+            if first:
+                a_may_continue.wait(timeout=5)    # la saga nuova resta "in volo" mentre l'altra fallisce
+                return None
+            raise RuntimeError("store illeggibile")
+
+    exchange = _Exchange()
+    c = MicrostakeCoordinator(exchange=exchange, store=_Store())
+    outcomes = {}
+
+    def run(name):
+        try:
+            outcomes[name] = c.execute(_req("0.50", ref="same"), stub_price=D("2.02"), transient_cap=D("10")).phase.value
+        except RuntimeError:
+            outcomes[name] = "store_error"
+
+    threads = [threading.Thread(target=run, args=(n,), name=n) for n in ("A", "B")]
+    for t in threads:
+        t.start()
+    deadline = threading.Event()
+    for _ in range(100):                          # attende che il secondo chiamante abbia fallito load
+        if len(calls) == 2 and any(v == "store_error" for v in outcomes.values()):
+            break
+        deadline.wait(0.05)
+    assert len(calls) == 2 and any(v == "store_error" for v in outcomes.values()), (calls, outcomes)
+    assert exchange.has_reservation("same"), "riserva condivisa sciolta dal thread concorrente sullo stesso ref"
+    a_may_continue.set()
+    for t in threads:
+        t.join(timeout=10)
