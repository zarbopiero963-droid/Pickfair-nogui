+    def save_roserpina_config(self, config: RoserpinaConfig) -> None:
+        payload = self._roserpina_payload(config)
+        # PROPOSTA close02 CL02-RSR-RACE-001: se la config viene da un load,
+        # si scrivono SOLO i campi cambiati rispetto a quel load, e un campo
+        # cambiato anche da un altro salvataggio nel frattempo e' un conflitto
+        # (nessuna modifica concorrente persa in silenzio).
+        snapshot = getattr(config, "loaded_values", None) or None
+        # PROPOSTA close02 F6: versione di configurazione persistita e
+        # incrementata nella STESSA transazione dei valori (lettura+scrittura
+        # sotto il write lock del Database). Versione corrotta => errore,
+        # nessun reset silenzioso a 1.
+        try:
+            self._save_roserpina_tx(payload, snapshot)
+        except sqlite3.OperationalError as exc:
+            msg = str(exc).lower()
+            if "locked" in msg or "busy" in msg:
+                # contesa persistente sul lock: fail-closed, esplicito, nessuna scrittura
+                raise RuntimeError("CONFIG_CONFLICT:LOCK_CONTENTION") from exc
+            raise
+        if snapshot is not None:
+            config.loaded_values = dict(self._roserpina_payload(config))
+
+    CONFIG_SAVE_BUSY_TIMEOUT_MS = 2000
+
+    def _save_roserpina_tx(self, payload, snapshot) -> None:
+        tx_immediate = getattr(self.db, "_transaction_immediate", None)
+        tx = (tx_immediate(busy_timeout_ms=self.CONFIG_SAVE_BUSY_TIMEOUT_MS)
+              if callable(tx_immediate) else self.db.transaction())
+        with tx:
+            raw = self.db.get_settings().get("roserpina.config_version")
+            if raw in (None, ""):
+                previous = 0
+            else:
+                text = str(raw).strip()
+                if not text.isdigit():
+                    raise ValueError("roserpina.config_version non valida")
+                previous = int(text)
+            if snapshot is not None:
+                current = self.db.get_settings()
+                changed = {k: v for k, v in payload.items() if str(snapshot.get(k)) != str(v)}
+                conflicts = sorted(
+                    k for k in changed
+                    if k in current and str(current.get(k)) != str(snapshot.get(k))
+                    and str(current.get(k)) != str(changed[k])
+                )
+                if conflicts:
+                    raise RuntimeError("CONFIG_CONFLICT:" + ",".join(conflicts))
+                payload = changed
+            payload["roserpina.config_version"] = previous + 1
+            self.db.save_settings(payload)
 
