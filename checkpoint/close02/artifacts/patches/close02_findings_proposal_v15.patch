diff --git a/core/pnl_label.py b/core/pnl_label.py
new file mode 100644
index 0000000..e9507e2
--- /dev/null
+++ b/core/pnl_label.py
@@ -0,0 +1,87 @@
+"""PROPOSTA close02 v11 — owner t80u regola (3) (#426/6143637861): etichetta del P/L.
+
+Unica fonte per GUI, Telegram e gate: un P/L e' VERIFICATO solo con commissione
+confermata da Betfair; SIMULATO nel broker simulato; tutto il resto (compreso
+uno stato assente o sconosciuto) e' STIMATO, cioe' non verificato."""
+from __future__ import annotations
+
+import math
+from typing import Any, Mapping
+
+VERIFIED = "VERIFICATO"
+SIMULATED = "SIMULATO"
+ESTIMATED = "STIMATO"
+
+
+def pnl_label(data: Mapping[str, Any] | None) -> str:
+    status = str((data or {}).get("pnl_status") or "").strip().upper()
+    return status if status in (VERIFIED, SIMULATED) else ESTIMATED
+
+
+def format_pnl(value: Any, data: Mapping[str, Any] | None) -> str:
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        return f"n/d ({ESTIMATED})"
+    if not math.isfinite(v):
+        return f"n/d ({ESTIMATED})"
+    return f"{v:.2f} ({pnl_label(data)})"
+
+
+def _num(data: Mapping[str, Any], key: str) -> float | None:
+    raw = data.get(key)
+    if raw is None:
+        return 0.0
+    if isinstance(raw, bool):
+        return None
+    try:
+        v = float(raw)
+    except (TypeError, ValueError):
+        return None
+    return v if math.isfinite(v) else None
+
+
+def allows_risk_increase(data: Mapping[str, Any] | None) -> bool:
+    """Una decisione che AUMENTA il rischio (progressione/auto-next, target di
+    ciclo) puo' basarsi su questo P/L solo se non dipende da una commissione
+    stimata: VERIFICATO/SIMULATO, oppure nessuna commissione applicata (importo
+    e totale di mercato = 0, il P/L e' il lordo riportato). Valori illeggibili
+    => no (fail-closed)."""
+    data = data or {}
+    if pnl_label(data) in (VERIFIED, SIMULATED):
+        return True
+    amount = _num(data, "commission_amount")
+    total = _num(data, "market_commission_amount_total")
+    return amount is not None and total is not None and amount == 0.0 and total == 0.0
+
+
+# v12 — protezioni (daily-loss) con netto CONSERVATIVO se la commissione e' stimata.
+# Fonte documentata (Betfair Italia, support.betfair.it a_id 3754): "Il tasso base
+# di mercato (Market Base Rate, MBR) e' la commissione massima applicata su un
+# particolare mercato, che in Italia e' pari al 4,5%" ... "L'importo della
+# commissione da pagare e' arrotondato alle due cifre decimali piu' vicine. Per
+# importi che terminano in 0,005 e' prevista un'approssimazione per eccesso."
+# => limite superiore: 4,5% della vincita lorda + 0,01 EUR di margine di arrotondamento.
+BETFAIR_ITALY_MAX_COMMISSION_PCT = 4.5
+ROUNDING_MARGIN_EUR = 0.01
+
+
+def conservative_pnl(data: Mapping[str, Any] | None, net_pnl: Any) -> float:
+    """Netto da usare per le PROTEZIONI. Verificato/simulato/nessuna commissione
+    => il netto cosi' com'e'. Commissione stimata su una vincita => vincita meno
+    la commissione massima documentata (+ margine). Dati illeggibili => la
+    vincita e' considerata interamente a rischio (0), la perdita resta intera."""
+    try:
+        net = float(net_pnl)
+    except (TypeError, ValueError):
+        return 0.0
+    if not math.isfinite(net):
+        return 0.0
+    if net <= 0.0 or allows_risk_increase(data):
+        return net
+    data = data or {}
+    gross = _num(data, "gross_pnl")
+    if gross is None or "gross_pnl" not in data or gross <= 0.0:
+        return 0.0  # TECNICA_DELEGATA: non si puo' limitare la commissione => vincita a rischio
+    worst = gross * BETFAIR_ITALY_MAX_COMMISSION_PCT / 100.0 + ROUNDING_MARGIN_EUR
+    return max(0.0, min(net, gross - worst))
diff --git a/core/pre_v9_migration.py b/core/pre_v9_migration.py
new file mode 100644
index 0000000..7d019f9
--- /dev/null
+++ b/core/pre_v9_migration.py
@@ -0,0 +1,210 @@
+"""close02 v13 — migrazione una tantum delle installazioni pre-v9 (owner #426,
+opzione A, ratificata il 13/10/2026). PROPOSTA isolata, nessun dato inventato.
+
+Situazione: un DB con storia di rischio (daily-loss/risk-stop/emergenza/picco)
+ma senza registro protezioni (`risk.persist_ledger`) e' marcato REINIT_REQUIRED
+al primo avvio v9 e, fino alla migrazione, NON ammette nuovo rischio.
+
+Contratto (testo owner):
+- `inspect(db)` mostra all'operatore i valori persistiti, la loro provenienza
+  (DB/file), lo stato del risk-stop, l'emergenza e gli ordini incerti, piu' i
+  motivi di blocco; `digest` identifica esattamente lo stato mostrato.
+- `ratify(db, operatore=..., digest=...)` sblocca SOLO se lo stato e' completo,
+  coerente e verificabile e il digest coincide con quello mostrato. Non scrive
+  mai valori monetari: copia byte per byte le righe esistenti nelle copie
+  mancanti e aggiorna il solo registro. Non tocca risk-stop, emergenza, daily-loss.
+- Dati indispensabili mancanti/illeggibili/incoerenti o ordini incerti ⇒ resta
+  bloccato: serve una riconciliazione documentata (fuori da questo modulo).
+- Atomicita' e kill -9: il registro e' l'unione delle copie DB+file; il commit
+  scrive DB poi file. Finche' una delle due copie contiene ancora
+  REINIT_REQUIRED l'unione lo contiene ⇒ ancora bloccato. Ripetere `ratify`
+  completa la migrazione (idempotente). Audit append-only + riga DB.
+Mai raise verso il chiamante: gli errori diventano esiti bloccati.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+from datetime import datetime, timezone
+from typing import Any
+
+from core import daily_loss_store, risk_persistence as rp, risk_stop as stop_rules
+from core.atomic_io import atomic_write_text
+
+MIGRATION_DONE = "pre_v9_migrated"
+AUDIT_KEY = "risk.pre_v9_migration"
+EMERGENCY_KEYS = ("emergency_stopped", "emergency_stopped_at", "emergency_reason")
+
+
+def _audit_file(db: Any) -> str:
+    b = rp._base(db)
+    return b + ".pre_v9_migration.audit.jsonl" if b else ""
+
+
+def _raw_file(path: str):
+    r = rp._read_file(path)
+    return "<illeggibile>" if r is rp._UNREADABLE else r
+
+
+def _peak_status(raw):
+    v = rp._parse_peak(raw)
+    return "assente" if v is None else ("illeggibile" if v is rp._UNREADABLE else "ok"), v
+
+
+def _daily_status(raw):
+    if raw in (None, ""):
+        return "assente", None
+    if raw == "<illeggibile>":
+        return "illeggibile", None
+    try:
+        rec = json.loads(raw)
+        intraday = float(rec["intraday_realized_pnl"])
+        str(rec["day_utc"])
+        if not math.isfinite(intraday):
+            raise ValueError
+        return "ok", {"day_utc": rec["day_utc"], "intraday_realized_pnl": intraday,
+                      "breached": rec.get("breached") is True}
+    except Exception:
+        return "illeggibile", None
+
+
+def inspect(db: Any) -> dict:
+    s = rp._settings(db)
+    led = rp.ledger(db)
+    rep: dict = {"settings_leggibili": s is not rp._UNREADABLE,
+                 "registro": "illeggibile" if led is rp._UNREADABLE else sorted(led),
+                 "migrazione_richiesta": led is not rp._UNREADABLE and rp.REINIT_REQUIRED in led,
+                 "gia_migrata": led is not rp._UNREADABLE and MIGRATION_DONE in led}
+    s = s if isinstance(s, dict) else {}
+    peak_db, peak_file = s.get(rp.EQUITY_PEAK_KEY), _raw_file(rp._peak_file(db))
+    dl_db, dl_file = s.get(daily_loss_store.DAILY_LOSS_STATE_KEY), _raw_file(daily_loss_store._marker_path(db))
+    vals = {}
+    for name, src, raw, status in (
+            ("equity_peak", "db:" + rp.EQUITY_PEAK_KEY, peak_db, _peak_status(peak_db)),
+            ("equity_peak", "file:.equity_peak.json", peak_file, _peak_status(peak_file)),
+            ("daily_loss", "db:daily_loss_state", dl_db, _daily_status(dl_db)),
+            ("daily_loss", "file:.daily_loss_pending.json", dl_file, _daily_status(dl_file))):
+        vals.setdefault(name, []).append({"provenienza": src, "grezzo": raw, "stato": status[0],
+                                          "valore": status[1] if status[0] == "ok" else None})
+    rep["valori"] = vals
+    copies = stop_rules._copies(db)
+    rep["risk_stop"] = {"motivo_attivo": stop_rules.restore_risk_stop(db),
+                        "copie": ["illeggibile" if c is rp._UNREADABLE else ("assente" if c is None else "ok")
+                                  for c in copies]}
+    rep["emergenza"] = {k: s.get(k) for k in EMERGENCY_KEYS}
+    try:
+        pend = db.get_pending_sagas() if hasattr(db, "get_pending_sagas") else []
+        rep["ordini_incerti"] = [{"customer_ref": p.get("customer_ref"), "stato": p.get("status"),
+                                  "market_id": p.get("market_id")} for p in pend or []]
+        rep["ordini_leggibili"] = True
+    except Exception:
+        rep["ordini_incerti"], rep["ordini_leggibili"] = [], False
+    rep["bloccanti"] = _blockers(rep)
+    rep["digest"] = hashlib.sha256(json.dumps(
+        {k: v for k, v in rep.items() if k != "digest"}, sort_keys=True, default=str).encode()).hexdigest()
+    return rep
+
+
+def _blockers(rep: dict) -> list:
+    out = []
+    if not rep["settings_leggibili"]:
+        out.append("settings_illeggibili")
+    if rep["registro"] == "illeggibile":
+        out.append("registro_illeggibile")
+    elif rep["gia_migrata"] and not rep["migrazione_richiesta"]:
+        out.append("migrazione_gia_eseguita")
+    elif not rep["migrazione_richiesta"]:
+        out.append("migrazione_non_richiesta")
+    for name in ("equity_peak", "daily_loss"):
+        cs = rep["valori"][name]
+        if any(c["stato"] == "illeggibile" for c in cs):
+            out.append(f"{name}_illeggibile")
+        ok = [c for c in cs if c["stato"] == "ok"]
+        if not ok:
+            out.append(f"{name}_mancante")  # dato indispensabile: mai inventato
+        elif len(ok) == 2 and ok[0]["valore"] != ok[1]["valore"]:
+            out.append(f"{name}_copie_incoerenti")
+    if "illeggibile" in rep["risk_stop"]["copie"] or rep["risk_stop"]["motivo_attivo"].startswith("risk_stop_reset_guard"):
+        out.append("risk_stop_illeggibile")
+    if not rep["ordini_leggibili"]:
+        out.append("ordini_illeggibili")
+    elif rep["ordini_incerti"]:
+        out.append("ordini_incerti_riconciliazione_richiesta")
+    return out
+
+
+def _audit(db: Any, record: dict) -> bool:
+    line = json.dumps(record, sort_keys=True, default=str)
+    ok = True
+    f = _audit_file(db)
+    try:
+        if f:
+            with open(f, "a", encoding="utf-8") as fh:
+                fh.write(line + "\n"); fh.flush(); os.fsync(fh.fileno())
+    except Exception:
+        ok = False
+    try:
+        db.save_settings({AUDIT_KEY: line})
+    except Exception:
+        ok = False
+    return ok
+
+
+def _last_audit(db: Any) -> str:
+    try:
+        rec = json.loads((db.get_settings() or {}).get(AUDIT_KEY) or "{}")
+        return str(rec.get("esito") or "")
+    except Exception:
+        return ""
+
+
+def ratify(db: Any, *, operatore: str, digest: str) -> dict:
+    """Ratifica manuale una tantum. Ritorna {"ok": bool, "motivo": str, "report": dict}."""
+    try:
+        rep = inspect(db)
+    except Exception as exc:  # pragma: no cover - fail-closed
+        return {"ok": False, "motivo": f"ispezione_fallita:{type(exc).__name__}", "report": {}}
+    now = datetime.now(timezone.utc).isoformat()
+    base = {"at": now, "operatore": str(operatore or ""), "digest_mostrato": digest, "digest": rep["digest"]}
+    if not str(operatore or "").strip():
+        motivo = "operatore_mancante"
+    elif digest != rep["digest"]:
+        motivo = "digest_non_corrispondente"  # l'operatore non ha visto questo stato
+    elif rep["bloccanti"]:
+        motivo = "bloccato:" + ",".join(rep["bloccanti"])
+    else:
+        motivo = ""
+    if rep["bloccanti"] == ["migrazione_gia_eseguita"] and _last_audit(db) not in ("COMPLETATA", "COMPLETATA_RECUPERATA"):
+        # kill -9 tra il commit del registro e l'audit finale: chiude la traccia
+        _audit(db, dict(base, esito="COMPLETATA_RECUPERATA"))
+    if motivo:
+        _audit(db, dict(base, esito="RIFIUTATA", motivo=motivo))
+        return {"ok": False, "motivo": motivo, "report": rep}
+    if not _audit(db, dict(base, esito="INTENTO", report=rep)):
+        return {"ok": False, "motivo": "audit_non_scrivibile", "report": rep}
+    try:
+        # copie mancanti: byte per byte dalla copia esistente (nessun valore nuovo)
+        peak = {c["provenienza"]: c for c in rep["valori"]["equity_peak"]}
+        if peak["file:.equity_peak.json"]["stato"] == "assente" and rp._peak_file(db):
+            atomic_write_text(rp._peak_file(db), peak["db:" + rp.EQUITY_PEAK_KEY]["grezzo"])
+        elif peak["db:" + rp.EQUITY_PEAK_KEY]["stato"] == "assente":
+            db.save_settings({rp.EQUITY_PEAK_KEY: peak["file:.equity_peak.json"]["grezzo"]})
+        led = set(rep["registro"]) - {rp.REINIT_REQUIRED}
+        led |= {"equity_peak", "daily_loss", MIGRATION_DONE}
+        if "ok" in rep["risk_stop"]["copie"]:
+            led.add("risk_stop")
+        new = json.dumps(sorted(led))
+        db.save_settings({rp.LEDGER_KEY: new})          # commit 1/2
+        if rp._ledger_file(db):
+            atomic_write_text(rp._ledger_file(db), new)  # commit 2/2
+    except Exception as exc:
+        _audit(db, dict(base, esito="FALLITA", motivo=type(exc).__name__))
+        return {"ok": False, "motivo": f"scrittura_fallita:{type(exc).__name__}", "report": rep}
+    after = rp.ledger(db)
+    if after is rp._UNREADABLE or rp.REINIT_REQUIRED in after:
+        _audit(db, dict(base, esito="FALLITA", motivo="registro_non_aggiornato"))
+        return {"ok": False, "motivo": "registro_non_aggiornato", "report": rep}
+    _audit(db, dict(base, esito="COMPLETATA"))
+    return {"ok": True, "motivo": "", "report": rep}
