+"""t81u: prove su RST-001/002 (nessun percorso capace di generare ordini dopo recovery
+non riuscita) e RST-003 (picco equity, risk-stop e daily-loss non resettabili da riavvii,
+kill -9 ripetuti, righe corrotte/mancanti). RED a 028cee9, GREEN col patch proposto."""
+import json, os, signal, sqlite3, subprocess, sys, textwrap
+from unittest.mock import MagicMock
+import pytest
+from database import Database
+from services.setting_service import SettingsService
+from core.runtime_controller import RuntimeController
+from core.system_state import RuntimeMode
+import core.state_recovery as sr
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+# Valori owner espliciti e validi (t80u): senza di essi il nuovo rischio e' bloccato.
+OWNER_VALID = {"roserpina.max_single_bet_pct": "5.0", "roserpina.max_total_exposure_pct": "20.0",
+               "roserpina.max_event_exposure_pct": "10.0", "roserpina.max_stake_abs": "50.0",
+               "roserpina.commission_pct": "5.0", "roserpina.max_recovery_tables": "1",
+               "roserpina.allow_recovery": "0"}
+ORDER_WORDS = ("place", "replace", "submit_order", "quick_bet", "execute")
+
+
+class _RE:
+    def __init__(self, scen): self.scen = scen
+    def fetch_startup_active_orders(self):
+        if self.scen == "incerto":
+            raise ConnectionError("exchange non raggiungibile")
+        if self.scen in ("fantasma", "db_errore"):
+            return [{"bet_id": "BX-GHOST", "market_id": "1.999", "selection_id": 7, "side": "BACK",
+                     "size_remaining": 3.0, "price": 2.0, "customer_ref": "CR-GHOST"}]
+        return []
+    def merge_startup_active_orders(self, o):
+        if self.scen == "merge_errore":
+            raise RuntimeError("merge fallito")
+        return {"orders": o}
+    def reconcile_all_open_batches(self): return None
+    def __getattr__(self, n): return MagicMock()
+
+
+def _ctl(path, monkeypatch, scen="normale", funds=1000.0, owner=None):
+    db = Database(path)
+    db.save_settings(OWNER_VALID if owner is None else owner)
+    ss = SettingsService(db)
+    bf = MagicMock(); bf._session_invalid = False
+    bf.connect.return_value = {"ok": True}; bf.get_account_funds.return_value = {"available": funds}
+    te, ex, bus = MagicMock(), MagicMock(), MagicMock()
+    rc = RuntimeController(bus=bus, db=db, settings_service=ss, betfair_service=bf,
+                           telegram_service=MagicMock(), trading_engine=te, executor=ex)
+    rc._catalog_sync = MagicMock()
+    monkeypatch.setattr(rc, "_start_market_data_feed", lambda: None)
+    monkeypatch.setattr(rc, "_start_settlement_poller", lambda: None)
+    monkeypatch.setattr(rc, "_build_reconciliation_engine", lambda: _RE(scen))
+    if scen == "db_errore":
+        def boom(order): raise sqlite3.OperationalError("disk I/O error")
+        monkeypatch.setattr(db, "startup_order_exists", boom)
+    if scen == "recover_eccezione":
+        def rboom(self): raise RuntimeError("recover esploso")
+        monkeypatch.setattr(sr.StateRecovery, "recover", rboom)
+    return rc
+
+
+def _arm_spies(rc, monkeypatch):
+    d = MagicMock(); d.approved = True; d.recommended_stake = 1.0; d.table_id = 1; d.reason = ""
+    monkeypatch.setattr(rc.mm, "calculate", MagicMock(return_value=d))
+    rc.bus.reset_mock(); rc.trading_engine.reset_mock(); rc.executor.reset_mock(); rc.betfair_service.reset_mock()
+
+
+def _order_calls(rc):
+    """Tutti i punti capaci di generare ordini: sizing, builder/engine, executor, broker, bus CMD."""
+    hits = []
+    if rc.mm.calculate.called:
+        hits.append("sizing")
+    for name, m in (("trading_engine", rc.trading_engine), ("executor", rc.executor), ("broker", rc.betfair_service)):
+        for c in m.mock_calls:
+            n = str(c[0]).lower()
+            if any(w in n for w in ORDER_WORDS) or (name != "broker" and n):
+                hits.append(f"{name}.{c[0]}")
+    for c in rc.bus.publish.call_args_list:
+        if str(c.args[0]).startswith("CMD_"):
+            hits.append("bus." + c.args[0])
+    return hits
+
+
+SIGNALS = [
+    {"market_id": "1.123", "selection_id": "456", "price": 2.0, "signal_type": "BACK"},
+    {"market_id": "1.124", "selection_id": "457", "price": 3.0, "signal_type": "LAY"},
+    {"market_id": "1.125", "selection_id": "458", "price": 1.8, "signal_type": "BACK", "copy_meta": {"master": "M1"}},
+    {"market_id": "1.126", "selection_id": "459", "price": 2.2, "signal_type": "BACK", "pattern_meta": {"pattern": "P1"}},
+]
+
+
+def _fire_all(rc):
+    for s in SIGNALS:
+        rc._on_signal_received(dict(s))
+    rc._evaluate_and_maybe_submit_auto_next_trade(
+        payload={"auto_trade_enabled": True, "recovery_enabled": True, "resume_submit_enabled": True,
+                 "cycle_executor_enabled": True, "market_id": "1.123", "selection_id": "456"},
+        sync_result={"bankroll_sync_status": "SYNCED", "correlation_id": "c1"})
+
+
+@pytest.mark.parametrize("scen", ["incerto", "merge_errore", "db_errore", "recover_eccezione"])
+def test_a_nessun_percorso_ordini_dopo_recovery_non_riuscita(tmp_path, monkeypatch, scen):
+    rc = _ctl(str(tmp_path / "a.sqlite"), monkeypatch, scen=scen)
+    rc.start(execution_mode="SIMULATION")
+    assert rc.mode is not RuntimeMode.ACTIVE
+    _arm_spies(rc, monkeypatch)
+    _fire_all(rc)
+    rc.resume()                      # resume non deve scavalcare
+    rc.start(execution_mode="SIMULATION")   # nemmeno un secondo start con recovery ancora fallita
+    _arm_spies(rc, monkeypatch)
+    _fire_all(rc)
+    assert rc.mode is not RuntimeMode.ACTIVE
+    assert _order_calls(rc) == []
+
+
+def test_a_controllo_discriminante_recovery_ok_raggiunge_il_sizing(tmp_path, monkeypatch):
+    rc = _ctl(str(tmp_path / "a.sqlite"), monkeypatch, scen="normale")
+    rc.start(execution_mode="SIMULATION")
+    _arm_spies(rc, monkeypatch)
+    rc._on_signal_received(dict(SIGNALS[0]))
+    assert "sizing" in _order_calls(rc)
+
+
+# ------------------------- (b) persistenza fail-closed -------------------------
+_CHILD = textwrap.dedent("""
+    import os, sys, signal, io, contextlib, json
+    sys.path.insert(0, %r)
+    from unittest.mock import MagicMock
+    from database import Database
+    from services.setting_service import SettingsService
+    from core.runtime_controller import RuntimeController
+    p, funds, action = sys.argv[1], float(sys.argv[2]), sys.argv[3]
+    db = Database(p); ss = SettingsService(db)
+    if action in ("daily_loss", "daily_loss_parziale"):
+        c = ss.load_roserpina_config(); c.max_daily_loss = 10.0; ss.save_roserpina_config(c)
+    bf = MagicMock(); bf._session_invalid = False
+    bf.connect.return_value = {"ok": True}; bf.get_account_funds.return_value = {"available": funds}
+    class RE:
+        def fetch_startup_active_orders(self): return []
+        def __getattr__(self, n): return MagicMock()
+    with contextlib.redirect_stdout(io.StringIO()):
+        rc = RuntimeController(bus=MagicMock(), db=db, settings_service=ss, betfair_service=bf, telegram_service=MagicMock())
+        rc._catalog_sync = MagicMock(); rc._start_market_data_feed = lambda: None; rc._start_settlement_poller = lambda: None
+        rc._build_reconciliation_engine = lambda: RE(); rc._route_cashout_signal = lambda *a, **k: None
+        rc.start(execution_mode="SIMULATION")
+        if action == "risk_stop":
+            rc.risk_stop("session_loss_breached:test")
+        if action == "emergenza":
+            rc.emergency_stop("test_manuale")
+        if action == "daily_loss_parziale":
+            rc.risk_desk.realized_pnl = -8.0
+            rc._monitor_daily_loss_breach(source="TEST")
+        if action == "daily_loss":
+            rc.risk_desk.realized_pnl = -12.0
+            st = rc._monitor_daily_loss_breach(source="TEST")
+            if st.get("breached"):
+                rc._enforce_daily_loss_hard_stop(st)
+    os.kill(os.getpid(), signal.SIGKILL)
+""") % ROOT
+
+
+def _run_and_kill(p, funds=1000.0, action="none"):
+    r = subprocess.run([sys.executable, "-c", _CHILD, p, str(funds), action], capture_output=True, text=True, timeout=120)
+    assert r.returncode == -signal.SIGKILL, r.stderr[-800:]
+
+
+def _restart(p, monkeypatch, funds):
+    rc = _ctl(p, monkeypatch, funds=funds)
+    rc.start(execution_mode="SIMULATION")
+    rej = []
+    monkeypatch.setattr(rc, "_reject_signal", lambda sg, r: rej.append(r))
+    _arm_spies(rc, monkeypatch)
+    rc._on_signal_received(dict(SIGNALS[0]))
+    return rc, rej
+
+
+def _blocked(rc):
+    return "sizing" not in _order_calls(rc) and not any(h.startswith("bus.CMD_") for h in _order_calls(rc))
+
+
+def _set_raw(p, key, value):
+    con = sqlite3.connect(p)
+    if value is None:
+        con.execute("DELETE FROM settings WHERE key=?", (key,))
+    else:
+        con.execute("UPDATE settings SET value=? WHERE key=?", (value, key))
+    con.commit(); con.close()
+
+
+@pytest.mark.parametrize("funds,blocca", [(989.0, True), (990.0, True), (990.01, False)])
