+"""close02 v9: regole owner t80u (#426/6143637861), RSR-38..40 nel runtime, registro
+daily-loss/emergenza indispensabile, picco persistito a ogni nuovo massimo, registro
+sparito con storia ⇒ fail-closed. RED a 028cee9, GREEN col patch proposto."""
+import json, os, signal, sqlite3, subprocess, sys, textwrap
+from unittest.mock import MagicMock
+import pytest
+from database import Database
+from services.setting_service import SettingsService
+from tests.close02.test_close02_restart_t81u import (
+    OWNER_VALID, SIGNALS, _ctl, _arm_spies, _order_calls, _fire_all, _run_and_kill, _set_raw, _restart, _blocked, ROOT)
+
+BLOCKING = ["roserpina.max_single_bet_pct", "roserpina.max_total_exposure_pct",
+            "roserpina.max_event_exposure_pct", "roserpina.max_stake_abs", "roserpina.commission_pct"]
+
+
+def _owner_without(key, raw):
+    d = dict(OWNER_VALID)
+    if raw is None:
+        d.pop(key)
+    else:
+        d[key] = raw
+    return d
+
+
+# ---------------- t80u regole (1) e (3): nessun percorso ordini ----------------
+@pytest.mark.parametrize("raw", [None, "abc", "", "nan"])
+@pytest.mark.parametrize("key", BLOCKING)
+def test_t80u_chiave_assente_o_non_valida_blocca_ogni_percorso_ordini(tmp_path, monkeypatch, key, raw):
+    rc = _ctl(str(tmp_path / "o.sqlite"), monkeypatch, owner=_owner_without(key, raw))
+    rej = []
+    rc.start(execution_mode="SIMULATION")
+    monkeypatch.setattr(rc, "_reject_signal", lambda sg, r: rej.append(r))
+    _arm_spies(rc, monkeypatch)
+    _fire_all(rc)
+    assert _order_calls(rc) == [], (key, raw)
+    assert rej and all("owner_t80u" in str(r) or "config_corrotta" in str(r) for r in rej), rej
+    ok, why = rc._risk_allows_auto_trade()
+    assert ok is False
+
+
+def test_t80u_controllo_tutte_valide_raggiunge_il_sizing(tmp_path, monkeypatch):
+    rc = _ctl(str(tmp_path / "o.sqlite"), monkeypatch)
+    rc.start(execution_mode="SIMULATION")
+    _arm_spies(rc, monkeypatch)
+    rc._on_signal_received(dict(SIGNALS[0]))
+    assert "sizing" in _order_calls(rc)
+
+
+def test_t80u_config_non_verificabile_blocca():
+    from core import validators
+    assert validators.owner_t80u_new_risk_block_reason(None)
+
+
+# ---------------- t80u regola (2): recovery ----------------
+@pytest.mark.parametrize("key", ["roserpina.max_recovery_tables", "roserpina.allow_recovery"])
+@pytest.mark.parametrize("raw", [None, "abc", ""])
+def test_t80u_recovery_assente_o_non_valida_mai_attiva(tmp_path, key, raw):
+    db = Database(str(tmp_path / "r.sqlite"))
+    d = _owner_without(key, raw); d["roserpina.allow_recovery"] = d.get("roserpina.allow_recovery", "1") if key != "roserpina.allow_recovery" else d.get(key)
+    if key != "roserpina.allow_recovery":
+        d["roserpina.allow_recovery"] = "1"  # anche con allow_recovery=1 esplicito
+    db.save_settings({k: v for k, v in d.items() if v is not None})
+    cfg = SettingsService(db).load_roserpina_config()
+    assert cfg.allow_recovery is False                     # mai True per assenza/invalidita'
+    if key == "roserpina.max_recovery_tables":
+        assert cfg.max_recovery_tables == 0                # nessun massimo inventato
+    else:
+        assert cfg.max_recovery_tables == 1                # il massimo esplicito valido resta
+
+
+@pytest.mark.parametrize("raw", [None, "abc", ""])
+def test_t80u_commissione_non_verificata_non_inventata(tmp_path, raw):
+    db = Database(str(tmp_path / "c.sqlite"))
+    db.save_settings({k: v for k, v in _owner_without("roserpina.commission_pct", raw).items()})
+    cfg = SettingsService(db).load_roserpina_config()
+    assert cfg.commission_pct is None
+
+
+def test_t80u_recovery_esplicita_valida_conservata(tmp_path):
+    db = Database(str(tmp_path / "r.sqlite"))
+    db.save_settings(dict(OWNER_VALID, **{"roserpina.allow_recovery": "1", "roserpina.max_recovery_tables": "3"}))
+    cfg = SettingsService(db).load_roserpina_config()
+    assert cfg.allow_recovery is True and cfg.max_recovery_tables == 3
+
+
+def test_t80u_load_segnala_assenza(tmp_path):
+    cfg = SettingsService(Database(str(tmp_path / "a.sqlite"))).load_roserpina_config()
+    assert set(BLOCKING) <= set(getattr(cfg, "absent_keys", ()))
+
+
+# ---------------- RSR-38..40 nel runtime ----------------
+@pytest.mark.parametrize("key", ["max_order_exposure", "max_market_exposure", "max_event_exposure_abs"])
+def test_rsr38_40_caricate_dopo_riavvio(tmp_path, key):
+    p = str(tmp_path / "c.sqlite")
+    Database(p).save_settings({"roserpina." + key: "7.5"})
+    cfg = SettingsService(Database(p)).load_roserpina_config()
+    assert getattr(cfg, key, "<assente>") == 7.5
+
+
+# ---------------- M10: registro daily-loss/emergenza indispensabile ----------------
+def test_daily_loss_ed_emergenza_righe_sparite_fail_closed(tmp_path, monkeypatch):
+    p = str(tmp_path / "l.sqlite")
+    _run_and_kill(p, action="daily_loss")
+    for k in ("daily_loss_state", "emergency_stopped", "emergency_stopped_at", "emergency_reason"):
+        _set_raw(p, k, None)
+    for f in os.listdir(tmp_path):
+        if f.endswith(".daily_loss_pending.json"):
+            os.remove(tmp_path / f)
+    rc, rej = _restart(p, monkeypatch, 1000.0)
+    assert _blocked(rc), rej
+    rc2, rej2 = _restart(p, monkeypatch, 1000.0)   # il blocco resta anche al riavvio successivo
+    assert _blocked(rc2), rej2
+
+
+# ---------------- picco persistito a ogni nuovo massimo in sessione ----------------
+_CHILD_HIGH = textwrap.dedent("""
+    import os, sys, signal, io, contextlib
+    sys.path.insert(0, %r)
+    from unittest.mock import MagicMock
+    from database import Database
+    from services.setting_service import SettingsService
+    from core.runtime_controller import RuntimeController
+    db = Database(sys.argv[1]); ss = SettingsService(db)
+    bf = MagicMock(); bf._session_invalid = False
+    bf.connect.return_value = {"ok": True}; bf.get_account_funds.return_value = {"available": 1000.0}
+    class RE:
+        def fetch_startup_active_orders(self): return []
+        def __getattr__(self, n): return MagicMock()
+    with contextlib.redirect_stdout(io.StringIO()):
+        rc = RuntimeController(bus=MagicMock(), db=db, settings_service=ss, betfair_service=bf, telegram_service=MagicMock())
+        rc._catalog_sync = MagicMock(); rc._start_market_data_feed = lambda: None; rc._start_settlement_poller = lambda: None
+        rc._build_reconciliation_engine = lambda: RE()
+        rc.start(execution_mode="SIMULATION")
+        rc.risk_desk.sync_bankroll(1100.0)   # nuovo massimo in sessione (es. settlement vinto)
+    os.kill(os.getpid(), signal.SIGKILL)
+""") % ROOT
+
+
+@pytest.mark.parametrize("funds,blocca", [(1089.0, True), (1090.0, True), (1090.01, False)])
+def test_picco_nuovo_massimo_in_sessione_sopravvive_kill9(tmp_path, monkeypatch, funds, blocca):
+    p = str(tmp_path / "h.sqlite")
+    r = subprocess.run([sys.executable, "-c", _CHILD_HIGH, p], capture_output=True, text=True, timeout=120)
+    assert r.returncode == -signal.SIGKILL, r.stderr[-500:]
+    rc, rej = _restart(p, monkeypatch, funds)
+    assert _blocked(rc) is blocca, rej
+
+
+# ---------------- registro sparito insieme alle copie protette ----------------
+def test_registro_e_copie_spariti_con_storia_fail_closed(tmp_path, monkeypatch):
+    p = str(tmp_path / "v.sqlite")
+    _run_and_kill(p)
+    for k in ("risk.equity_peak_eur", "risk.persist_ledger"):
+        _set_raw(p, k, None)
+    for f in os.listdir(tmp_path):
+        if f.endswith((".equity_peak.json", ".risk_ledger.json")):
+            os.remove(tmp_path / f)
+    rc, rej = _restart(p, monkeypatch, 989.0)
+    assert _blocked(rc), rej
+    # e il blocco e' durevole: un secondo riavvio non lo trasforma in primo avvio
+    rc2, rej2 = _restart(p, monkeypatch, 989.0)
+    assert _blocked(rc2), rej2
+
+
+def test_primo_avvio_autentico_resta_ammesso(tmp_path, monkeypatch):
+    rc, rej = _restart(str(tmp_path / "nuovo.sqlite"), monkeypatch, 1000.0)
+    assert not _blocked(rc), rej
+
+
+def test_daily_loss_parziale_riga_sparita_non_azzera_la_perdita(tmp_path, monkeypatch):
+    """Perdita del giorno 8 € su 10 (nessun breach, nessuna emergenza): la riga
+    daily-loss sparisce dopo il kill -9 ⇒ il riavvio NON deve ripartire da 0 €."""
+    p = str(tmp_path / "pz.sqlite")
+    _run_and_kill(p, action="daily_loss_parziale")
+    _set_raw(p, "daily_loss_state", None)
+    for f in os.listdir(tmp_path):
+        if f.endswith(".daily_loss_pending.json"):
+            os.remove(tmp_path / f)
+    rc, rej = _restart(p, monkeypatch, 1000.0)
+    assert _blocked(rc), rej
+    rc2, rej2 = _restart(p, monkeypatch, 1000.0)   # il blocco resta anche al riavvio successivo
+    assert _blocked(rc2), rej2
+
+
+def test_emergenza_riga_sparita_dopo_kill9_resta_attiva(tmp_path, monkeypatch):
+    """Emergency stop manuale (nessun breach daily-loss): righe emergenza sparite ⇒ fail-closed."""
+    p = str(tmp_path / "em.sqlite")
+    _run_and_kill(p, action="emergenza")
+    for k in ("emergency_stopped", "emergency_stopped_at", "emergency_reason"):
+        _set_raw(p, k, None)
+    rc, rej = _restart(p, monkeypatch, 1000.0)
+    assert _blocked(rc), rej
