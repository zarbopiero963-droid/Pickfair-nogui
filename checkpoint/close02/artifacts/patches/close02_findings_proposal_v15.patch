+"""close02 v10: (a) P/L con commissione etichettata STIMATA/VERIFICATA (owner t80u
+regola 3, #426/6143637861); (b) segnali LOAD distinti assente/vuoto/corrotto sui
+cap opzionali e assente vs esplicito-uguale-al-default. RED a 028cee9, GREEN col patch."""
+import pytest
+from database import Database
+from services.setting_service import SettingsService
+from tests.close02.test_close02_restart_t81u import OWNER_VALID, SIGNALS, _ctl, _arm_spies, _order_calls
+
+OPTIONAL = ["max_daily_loss", "max_drawdown_hard_stop_pct", "max_drawdown_abs", "max_open_exposure",
+            "max_session_loss", "max_exposure_stop", "max_recovery_chase_abs",
+            "max_order_exposure", "max_market_exposure", "max_event_exposure_abs"]
+
+
+def _load(tmp_path, extra):
+    db = Database(str(tmp_path / "c.sqlite"))
+    db.save_settings(dict(OWNER_VALID, **extra))
+    return SettingsService(db).load_roserpina_config()
+
+
+def _sig(cfg):
+    return tuple(tuple(getattr(cfg, n, ("<n/a>",)) or ()) for n in
+                 ("corrupt_keys", "empty_keys", "absent_optional_keys", "defaulted_keys"))
+
+
+@pytest.mark.parametrize("name", OPTIONAL)
+def test_cap_opzionale_assente_vuoto_corrotto_override_distinti(tmp_path, name):
+    k = "roserpina." + name
+    stati = {}
+    for scen, extra in (("assente", {}), ("vuoto", {k: ""}), ("corrotto", {k: "abc"}), ("override", {k: "7.5"})):
+        d = tmp_path / scen; d.mkdir()
+        stati[scen] = _load(d, extra)
+    assert k in getattr(stati["assente"], "absent_optional_keys", ())
+    assert k in getattr(stati["vuoto"], "empty_keys", ())
+    assert k in getattr(stati["corrotto"], "corrupt_keys", ())
+    o = stati["override"]
+    assert k not in getattr(o, "absent_optional_keys", ()) and k not in getattr(o, "empty_keys", ()) \
+        and k not in getattr(o, "corrupt_keys", ())
+    assert len({_sig(c) for c in stati.values()}) == 4
+
+
+@pytest.mark.parametrize("name,default", [("table_count", "9"), ("target_profit_cycle_pct", "3.0")])
+def test_assente_distinto_da_esplicito_uguale_al_default(tmp_path, name, default):
+    k = "roserpina." + name
+    (tmp_path / "a").mkdir(); (tmp_path / "b").mkdir()
+    a = _load(tmp_path / "a", {}); b = _load(tmp_path / "b", {k: default})
+    assert k in getattr(a, "defaulted_keys", ())
+    assert k not in getattr(b, "defaulted_keys", ("<n/a>",))
+
+
+def test_cap_opzionale_corrotto_nessun_percorso_ordini(tmp_path, monkeypatch):
+    p = str(tmp_path / "o.sqlite")
+    rc = _ctl(p, monkeypatch, owner=dict(OWNER_VALID, **{"roserpina.max_session_loss": "abc"}))
+    rc.start(execution_mode="SIMULATION")
+    _arm_spies(rc, monkeypatch)
+    rc._on_signal_received(dict(SIGNALS[0]))
+    assert "sizing" not in _order_calls(rc) and _order_calls(rc) == []
+
+
+# ---------------- P/L: commissione stimata vs verificata ----------------
+def _engine():
