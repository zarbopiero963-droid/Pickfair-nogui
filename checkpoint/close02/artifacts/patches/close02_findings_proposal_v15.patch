diff --git a/scripts/pre_v9_migration.py b/scripts/pre_v9_migration.py
new file mode 100644
index 0000000..2a942c4
--- /dev/null
+++ b/scripts/pre_v9_migration.py
@@ -0,0 +1,38 @@
+"""close02 v13 — CLI operatore per la migrazione pre-v9 (owner #426, opzione A).
+
+Uso:  python scripts/pre_v9_migration.py <percorso_db>            (solo mostra)
+      python scripts/pre_v9_migration.py <percorso_db> --ratifica  (chiede conferma)
+
+Mostra valori persistiti, provenienza, risk-stop, emergenza, ordini incerti e
+bloccanti. La ratifica richiede nome operatore e il digest digitato a mano:
+vale solo per lo stato mostrato. Nessuna chiamata di rete, nessun ordine."""
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from core import pre_v9_migration as mig  # noqa: E402
+from database import Database  # noqa: E402
+
+
+def main(argv, inp=input, out=print) -> int:
+    if not argv:
+        out(__doc__)
+        return 2
+    db = Database(argv[0])
+    rep = mig.inspect(db)
+    out(json.dumps(rep, indent=2, sort_keys=True, ensure_ascii=False, default=str))
+    if rep["bloccanti"]:
+        out("BLOCCATO: " + ", ".join(rep["bloccanti"]) + " — serve riconciliazione documentata.")
+    if "--ratifica" not in argv[1:]:
+        return 0 if not rep["bloccanti"] else 1
+    operatore = inp("Nome operatore: ").strip()
+    digest = inp("Digita il digest mostrato sopra per confermare: ").strip()
+    res = mig.ratify(db, operatore=operatore, digest=digest)
+    out("ESITO: " + ("MIGRAZIONE COMPLETATA" if res["ok"] else "RIFIUTATA " + res["motivo"]))
+    return 0 if res["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
