+"""close02 v14 — ricostruzione del picco equity da getAccountStatement (owner #426,
+15:31). Solo fixture con i campi documentati (refId, itemDate, amount, balance,
+itemClass; moreAvailable). Nessuna chiamata reale. RED su v13, GREEN con v14."""
+import json, os, signal, subprocess, sys, textwrap
+from unittest.mock import MagicMock
+import pytest
+from database import Database
+from tests.close02.test_close02_restart_t81u import ROOT, _restart, _blocked, _set_raw, _order_calls
+from tests.close02.test_close02_v13 import _pre_v9, _first_boot, _ratify, _settings, PEAK_KEY, LEDGER_KEY
+
+REL, ASOF = "2026-09-01T00:00:00Z", "2026-10-13T12:00:00Z"
+WIN = {"from": "2026-08-01T00:00:00Z", "to": "2026-10-13T12:00:00Z"}
+
+
+def _pr():
+    from core import peak_reconstruction
+    return peak_reconstruction
+
+
+def _items(moves, start=0.0):
+    """moves: [(amount, classe)] in ordine cronologico; ritorna voci newest-first."""
+    out, bal = [], start
+    for i, (amt, cls) in enumerate(moves):
+        bal = round(bal + amt, 2)
+        out.append({"refId": f"R{i}", "itemDate": f"2026-09-{i + 2:02d}T10:00:00.000Z", "amount": amt,
+                    "balance": bal, "itemClass": cls, "itemClassData": {}, "legacyData": {}})
+    return list(reversed(out)), bal
+
+
+MOVES = [(1000.0, "DEPOSIT"), (250.0, "EXCHANGE_BET"), (-11.25, "EXCHANGE_COMMISSION"),
+         (-300.0, "EXCHANGE_BET"), (-100.0, "WITHDRAWAL"), (40.0, "EXCHANGE_BET")]
+# saldo: 1000, 1250, 1238.75 (picco), 938.75, 838.75, 878.75
+
+
+def _pages(items, size=4, window=WIN, more_last=False):
+    pages = []
+    for k in range(0, len(items), size):
+        chunk = items[k:k + size]
+        last = k + size >= len(items)
+        pages.append({"request": {"fromRecord": k, "recordCount": size, "includeItem": "ALL", "itemDateRange": dict(window)},
+                      "response": {"accountStatement": chunk, "moreAvailable": (more_last if last else True)}})
+    return pages
+
+
+def _ok(**kw):
+    items, bal = _items(MOVES)
+    args = dict(pages=_pages(items), relevant_from=REL, as_of=ASOF, current_balance=bal)
+    args.update(kw)
+    return _pr().reconstruct(args.pop("pages"), **args)
+
+
+# (1) sola lettura: unico metodo getAccountStatement, includeItem=ALL, paginazione
+def test_p1_sola_lettura_un_solo_metodo_e_paginazione():
+    items, _ = _items(MOVES)
+    pages = _pages(items, size=4)
+    calls = []
+    def call(params):
+        calls.append(params)
+        return pages[len(calls) - 1]["response"]
+    got = _pr().fetch_pages(call, date_from=WIN["from"], date_to=WIN["to"])
+    assert [c["fromRecord"] for c in calls] == [0, 4] and all(c["includeItem"] == "ALL" for c in calls)
+    from betfair_client import BetfairClient
+    bc = BetfairClient.__new__(BetfairClient)
+    bc._post_jsonrpc = MagicMock(return_value={"accountStatement": [], "moreAvailable": False})
+    bc.get_account_statement({"includeItem": "EXCHANGE"})
+    (url, method, params), _ = bc._post_jsonrpc.call_args
+    assert method == "AccountAPING/v1.0/getAccountStatement" and params["includeItem"] == "ALL"
+    assert len(got) == 2
+
+
+# (2) saldo (balance) dell'estratto, non il disponibile; commissioni e movimenti nella catena
+def test_p2_picco_dal_saldo_con_commissioni_e_movimenti():
+    prop = _ok()
+    assert prop["stato"] == "VERIFICATA_DA_RATIFICARE" and prop["picco_proposto"] == 1250.0
+    assert prop["calcoli"][0] == {"passo": "saldo_iniziale", "balance": 0.0}
+
+
+def test_p2b_massimo_parziale_non_usato_come_completo():
+    prop = _ok(pages=_pages(_items(MOVES)[0], window={"from": "2026-09-15T00:00:00Z", "to": WIN["to"]}))
+    assert prop["stato"] == "BLOCCATA" and "intervallo_non_copre_periodo_rilevante" in prop["motivi"]
+    assert prop["picco_proposto"] is None
+
+
+def test_p2c_storico_troncato_moreavailable():
+    prop = _ok(pages=_pages(_items(MOVES)[0], more_last=True))
+    assert prop["stato"] == "BLOCCATA" and "storico_troncato_moreAvailable" in prop["motivi"]
+
+
+def test_p2d_intervallo_non_arriva_a_oggi():
+    prop = _ok(pages=_pages(_items(MOVES)[0], window={"from": WIN["from"], "to": "2026-10-01T00:00:00Z"}))
+    assert "intervallo_non_arriva_alla_data_di_verifica" in prop["motivi"]
+
+
+def test_p2e_pagine_non_contigue_o_includeitem_diverso():
+    pages = _pages(_items(MOVES)[0])
+    pages[1]["request"]["fromRecord"] = 5
+    assert "pagina_1_fromRecord_non_contiguo" in _ok(pages=pages)["motivi"]
+    pages = _pages(_items(MOVES)[0]); pages[0]["request"]["includeItem"] = "EXCHANGE"
+    assert "pagina_0_includeItem_non_ALL" in _ok(pages=pages)["motivi"]
+
+
+# (3) evidenze, intervallo, fonti, calcoli, SHA, audit; manomissione rilevata
+def test_p3_evidenze_sha_audit_e_manomissione(tmp_path):
+    db = Database(str(tmp_path / "e.sqlite"))
+    items, bal = _items(MOVES); pages = _pages(items)
+    prop = _pr().reconstruct(pages, relevant_from=REL, as_of=ASOF, current_balance=bal)
+    assert prop["fonte"].startswith("AccountAPING/v1.0/getAccountStatement") and prop["intervallo"]["da"] == WIN["from"]
+    assert len(prop["evidenze_sha256"]) == 2 and len(prop["sha256"]) == 64 and len(prop["calcoli"]) == 7
+    path = _pr().save_proposal(db, prop, pages)
+    assert _pr().load_proposal(path)["sha256"] == prop["sha256"]
+    audit = [json.loads(x) for x in open(str(tmp_path / "e.sqlite") + ".peak_reconstruction.audit.jsonl")]
+    assert audit[-1]["esito"] == "PROPOSTA_VERIFICATA_DA_RATIFICARE"
+    data = json.load(open(path)); data["pagine_grezze"][0]["response"]["accountStatement"][0]["balance"] = 9999.0
+    open(path, "w").write(json.dumps(data))
+    with pytest.raises(ValueError):
+        _pr().load_proposal(path)
+
+
+# (4) niente valori inventati; saldo attuale non assunto come picco
+def test_p4_saldo_attuale_non_e_il_picco_e_catena_incoerente_blocca():
+    prop = _ok()
+    assert prop["picco_proposto"] == 1250.0 != 878.75
+    items, bal = _items(MOVES); items[2]["balance"] += 5.0
+    prop = _ok(pages=_pages(items))
+    assert prop["stato"] == "BLOCCATA" and any(m.startswith("catena_incoerente") for m in prop["motivi"])
+    assert prop["picco_proposto"] is None
+
+
+def test_p4b_saldo_attuale_diverso_o_illeggibile_blocca():
+    assert "saldo_finale_diverso_dal_saldo_attuale" in _ok(current_balance=900.0)["motivi"]
+    assert "saldo_attuale_non_verificabile" in _ok(current_balance=float("nan"))["motivi"]
+
+
+def test_p4c_voci_incomplete_o_duplicate_bloccano():
+    items, _ = _items(MOVES); del items[1]["balance"]
+    assert any(m.startswith("voce_incompleta") for m in _ok(pages=_pages(items))["motivi"])
+    items, _ = _items(MOVES); items.insert(0, dict(items[0]))
+    assert any(m.startswith("voce_duplicata") for m in _ok(pages=_pages(items))["motivi"])
+    assert "storico_vuoto" in _ok(pages=_pages([]) or [{"request": {"fromRecord": 0, "includeItem": "ALL", "itemDateRange": WIN},
+                                                        "response": {"accountStatement": [], "moreAvailable": False}}])["motivi"]
+
+
+# Flusso completo su installazione base (picco mai persistito)
+def _base_install(tmp_path, monkeypatch, action="none"):
+    p = _pre_v9(tmp_path, action=action, keep_peak=False); _first_boot(p, monkeypatch)
+    return p
+
+
+def _save(p, prop_kw=None):
+    items, bal = _items(MOVES); pages = _pages(items)
+    kw = dict(relevant_from=REL, as_of=ASOF, current_balance=bal); kw.update(prop_kw or {})
+    prop = _pr().reconstruct(pages, **kw)
+    return _pr().save_proposal(Database(p), prop, pages), prop
+
+
+# (6)(7) nessuno sblocco automatico: proposta salvata ≠ sblocco
+def test_p6_proposta_non_sblocca_e_non_scrive_il_picco(tmp_path, monkeypatch):
+    p = _base_install(tmp_path, monkeypatch)
+    _save(p)
+    assert PEAK_KEY not in _settings(p)
+    rc, rej = _restart(p, monkeypatch, 1250.0)
+    assert _blocked(rc), rej
+
+
+def test_p7_ratifica_owner_esplicita_obbligatoria(tmp_path, monkeypatch):
+    p = _base_install(tmp_path, monkeypatch); path, prop = _save(p)
+    m = _pr(); db = Database(p)
+    assert m.ratify_peak(db, path, owner="", owner_ref="#426", sha_digitato=prop["sha256"])["motivo"] == "ratifica_owner_mancante"
+    assert m.ratify_peak(db, path, owner="owner", owner_ref="#426", sha_digitato="x")["motivo"] == "sha_non_corrispondente"
+    assert PEAK_KEY not in _settings(p)
+
+
+def test_p6b_proposta_bloccata_non_ratificabile(tmp_path, monkeypatch):
+    p = _base_install(tmp_path, monkeypatch)
+    path, prop = _save(p, {"current_balance": 1.0})
+    r = _pr().ratify_peak(Database(p), path, owner="owner", owner_ref="#426", sha_digitato=prop["sha256"])
+    assert not r["ok"] and r["motivo"].startswith("proposta_bloccata") and PEAK_KEY not in _settings(p)
+
+
+def test_p7b_dopo_ratifica_picco_resta_bloccato_fino_alla_migrazione(tmp_path, monkeypatch):
+    p = _base_install(tmp_path, monkeypatch); path, prop = _save(p)
+    r = _pr().ratify_peak(Database(p), path, owner="owner", owner_ref="#426/x", sha_digitato=prop["sha256"])
+    assert r["ok"] and r["picco"] == 1250.0
+    rc, rej = _restart(p, monkeypatch, 1250.0)
+    assert _blocked(rc), rej                      # nessuno sblocco automatico
+    res, _ = _ratify(p)                           # flusso v13: operatore + digest
+    assert res["ok"], res["motivo"]
+    rc, rej = _restart(p, monkeypatch, 1250.0)
+    assert not _blocked(rc), rej
+    rc, rej = _restart(p, monkeypatch, 1239.0)    # 11 EUR sotto il picco ricostruito
+    assert _blocked(rc), rej
+
+
+# (4)(5) mai al ribasso; risk-stop e perdite invariati
+def test_p5_mai_al_ribasso_su_picco_esistente(tmp_path, monkeypatch):
+    p = _base_install(tmp_path, monkeypatch); path, prop = _save(p)
+    Database(p).save_settings({PEAK_KEY: json.dumps({"peak": 1300.0})})
+    r = _pr().ratify_peak(Database(p), path, owner="owner", owner_ref="#426", sha_digitato=prop["sha256"])
+    assert r["ok"] and r["picco"] == 1300.0
+
+
+def test_p5b_copia_picco_illeggibile_non_sovrascritta(tmp_path, monkeypatch):
+    p = _base_install(tmp_path, monkeypatch); path, prop = _save(p)
+    Database(p).save_settings({PEAK_KEY: "{rotto"})
+    r = _pr().ratify_peak(Database(p), path, owner="owner", owner_ref="#426", sha_digitato=prop["sha256"])
+    assert not r["ok"] and _settings(p)[PEAK_KEY] == "{rotto"
+
+
+@pytest.mark.parametrize("action", ["risk_stop", "daily_loss_parziale"])
+def test_p5c_riskstop_e_perdite_invariati(tmp_path, monkeypatch, action):
+    p = _base_install(tmp_path, monkeypatch, action=action); path, prop = _save(p)
+    keys = ("risk_stop_state", "daily_loss_state")
+    before = {k: _settings(p).get(k) for k in keys}
+    assert _pr().ratify_peak(Database(p), path, owner="o", owner_ref="#426", sha_digitato=prop["sha256"])["ok"]
+    assert {k: _settings(p).get(k) for k in keys} == before
+    assert _ratify(p)[0]["ok"]
+    rc, rej = _restart(p, monkeypatch, 1250.0)
+    if action == "risk_stop":
+        assert rc._risk_stop_reason and not any(h.startswith("bus.CMD_") for h in _order_calls(rc))
+    else:
+        assert rc._daily_loss_monitor_state.get("intraday_realized_pnl") == pytest.approx(-8.0)
+
+
+# (8) kill -9 durante la ratifica del picco: nessun reset, blocco mantenuto
+_KILL = textwrap.dedent("""
+    import os, sys, signal
+    sys.path.insert(0, %r)
+    from database import Database
+    from core import peak_reconstruction as m
+    p, path, sha, at = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
+    n = [0]
+    def tick():
+        n[0] += 1
+        if n[0] == at:
+            os.kill(os.getpid(), signal.SIGKILL)
+    db = Database(p)
+    o_s = db.save_settings
+    db.save_settings = lambda d: (tick(), o_s(d))[1]
+    o_w = m.atomic_write_text
+    m.atomic_write_text = lambda a, b: (tick(), o_w(a, b))[1]
+    o_a = m._audit
+    m._audit = lambda d, r: (tick(), o_a(d, r))[1]
+    print(m.ratify_peak(db, path, owner="owner", owner_ref="#426", sha_digitato=sha))
+""") % ROOT
+
+
+@pytest.mark.parametrize("at", [1, 2, 3, 4, 5])
+def test_p8_kill9_ratifica_picco(tmp_path, monkeypatch, at):
+    p = _base_install(tmp_path, monkeypatch); path, prop = _save(p)
+    r = subprocess.run([sys.executable, "-c", _KILL, p, path, prop["sha256"], str(at)], capture_output=True, text=True, timeout=120)
+    assert r.returncode in (-signal.SIGKILL, 0), r.stderr[-500:]
+    rc, rej = _restart(p, monkeypatch, 1250.0)
+    assert _blocked(rc), rej                    # mai sblocco, qualunque passo
+    raw = _settings(p).get(PEAK_KEY)
+    assert raw is None or json.loads(raw)["peak"] == 1250.0
+    assert _pr().ratify_peak(Database(p), path, owner="owner", owner_ref="#426", sha_digitato=prop["sha256"])["ok"]
+    assert _ratify(p)[0]["ok"]
+    rc, rej = _restart(p, monkeypatch, 1250.0)
+    assert not _blocked(rc), rej
+    rc, rej = _restart(p, monkeypatch, 1239.0)
+    assert _blocked(rc), rej
