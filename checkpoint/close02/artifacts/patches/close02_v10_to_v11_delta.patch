@@ -0,0 +1,181 @@
+"""close02 v11 — owner t80u regola (3) (#426/6143637861), seconda parte.
+(a) commissione da listClearedOrders: il campo ``commission`` e' documentato SOLO
+    con groupBy=MARKET (tabella "listClearedOrders - Roll-up Fields Available":
+    Commission N a BET/SIDE, Y a MARKET). Fixture con i soli campi documentati
+    (betId, marketId, profit, settledDate a livello BET; marketId, profit, commission,
+    betCount, settledDate a livello MARKET). Nessuna chiamata reale.
+(b) nessuna decisione che aumenta il rischio su P/L stimato; gli stop restano.
+(c) etichetta in GUI e Telegram. RED a 028cee9, GREEN col patch."""
+import math
+import pytest
+from tests.core.test_settlement_poller import _controller, _closes
+
+BET = {"betId": "101", "marketId": "1.100", "profit": 10.0, "settledDate": "2026-08-24T09:00:00Z"}
+
+
+class _BF:
+    """Fake documentato: righe BET senza commissione; rollup MARKET con commission/betCount."""
+    def __init__(self, bet_rows, market_rows=None, market_exc=None):
+        self.bet_rows, self.market_rows, self.market_exc, self.calls = bet_rows, market_rows or [], market_exc, []
+
+    def list_cleared_orders(self, **kw):
+        self.calls.append(dict(kw))
+        if kw.get("group_by") == "MARKET":
+            if self.market_exc:
+                raise self.market_exc
+            return [dict(r) for r in self.market_rows]
+        return [dict(r) for r in self.bet_rows]
+
+    def __getattr__(self, n):
+        return lambda *a, **k: {"available": 100.0} if n == "get_account_funds" else None
+
+
+def _poll(bet_rows, market_rows=None, market_exc=None, bot_orders=None):
+    rc = _controller(results=[], bot_orders=bot_orders)
+    rc.betfair_service = _BF(bet_rows, market_rows, market_exc)
+    rc._poll_cleared_settlements()
+    return rc, _closes(rc)
+
+
+def _mkt(**kw):
+    d = {"marketId": "1.100", "profit": 10.0, "commission": 0.45, "betCount": 1,
+         "settledDate": "2026-08-24T09:00:00Z"}
+    d.update(kw)
+    return d
+
+
+# ---------------- (a) estrazione commissione ----------------
+def test_a_rollup_market_coincidente_verifica_il_pl():
+    rc, closes = _poll([BET], [_mkt()])
+    assert closes and closes[-1]["commission_status"] == "VERIFICATA" and closes[-1]["pnl_status"] == "VERIFICATO"
+    mk = [c for c in rc.betfair_service.calls if c.get("group_by") == "MARKET"]
+    assert mk and mk[0]["bet_ids"] == ["101"] and mk[0]["bet_status"] == "SETTLED"
+
+
+@pytest.mark.parametrize("override,motivo", [
+    ({"commission": 0.40}, "importo diverso"),
+    ({"betCount": 2}, "altre bet nel mercato (non attribuibile)"),
+    ({"profit": 12.0}, "profit del rollup diverso"),
+    ({"commission": float("nan")}, "commissione non finita"),
+    ({"commission": None}, "commissione assente"),
+])
+def test_a_rollup_non_attribuibile_o_diverso_resta_stimato(override, motivo):
+    _, closes = _poll([BET], [_mkt(**override)])
+    assert closes and closes[-1]["pnl_status"] == "STIMATO", motivo
+
+
+def test_a_rollup_non_disponibile_settlement_emesso_e_stimato():
+    _, closes = _poll([BET], market_exc=RuntimeError("TIMEOUT"))
+    assert len(closes) == 1 and closes[0]["pnl_status"] == "STIMATO"
+
+
+def test_a_commissione_a_livello_bet_non_documentata_ignorata():
+    _, closes = _poll([dict(BET, commission=0.45)], [])
+    assert closes and closes[-1]["pnl_status"] == "STIMATO"
+
+
+def test_a_perdita_con_commissione_zero_verificata():
+    _, closes = _poll([dict(BET, profit=-5.0)], [_mkt(profit=-5.0, commission=0.0)])
+    assert closes[-1]["pnl_status"] == "VERIFICATO"
+
+
+def test_a_due_bet_stesso_mercato_verifica_solo_sull_ultima():
+    bots = [{"bet_id": "101", "market_id": "1.100", "event_name": "E1"},
+            {"bet_id": "102", "market_id": "1.100", "event_name": "E1"}]
+    rows = [BET, dict(BET, betId="102", profit=6.0)]
+    _, closes = _poll(rows, [_mkt(profit=16.0, betCount=2, commission=round(16.0 * 0.045, 2))], bot_orders=bots)
+    assert len(closes) == 2
+    assert [c["pnl_status"] for c in closes] == ["STIMATO", "VERIFICATO"]
+
+
+# ---------------- (b) gate aumento rischio ----------------
+from tests.integration.test_runtime_controller_auto_trade_mm import _make_controller, _canonical_close_payload
+from core.system_state import RuntimeMode
+
+
+def _auto(**over):
+    rc, bus = _make_controller(responses=[{"available": 150.0}])
+    rc.mode = RuntimeMode.ACTIVE
+    rc.risk_desk.sync_bankroll(100.0)
+    p = _canonical_close_payload(auto_trade_enabled=True, cycle_executor_enabled=True, mm_context={
+        "cycle_active": True, "cycle_id": "c1",
+        "table": {"table_id": 1, "loss_amount": 0.0, "in_recovery": False},
+        "next_signal": {"market_id": "1.234", "selection_id": 8, "price": 2.0}})
+    p.update(over)
+    for k, v in list(p.items()):
+        if v is None:
+            p.pop(k)
+    rc._on_close_position(p)
+    res = [e[1] for e in bus.events if e[0] == "AUTO_TRADE_MM_RESULT"][-1]
+    orders = [e for e in bus.events if e[0].startswith("CMD_")]
+    return res, orders
+
+
+@pytest.mark.parametrize("status", ["STIMATO", None, "verificato?", ""])
+def test_b_vincita_con_commissione_stimata_nessun_nuovo_ordine(status):
+    res, orders = _auto(pnl_status=status)
+    assert orders == [] and res["auto_trade_status"] == "AUTO_TRADE_SKIPPED_PNL_STIMATO"
+    assert res["submitted"] is False
+
+
+def test_b_controllo_verificato_invia():
+    res, orders = _auto()
+    assert res["submitted"] is True and orders
+
+
+def test_b_perdita_senza_commissione_non_dipende_da_stima():
+    res, _ = _auto(pnl_status="STIMATO", gross_pnl=-10.0, commission_amount=0.0, net_pnl=-10.0, pnl=-10.0,
+                   market_commission_amount_total=0.0)
+    assert res["auto_trade_status"] != "AUTO_TRADE_SKIPPED_PNL_STIMATO"
+
+
+def test_b_commissione_illeggibile_fail_closed():
+    from core.pnl_label import allows_risk_increase
+    assert not allows_risk_increase({"pnl_status": "STIMATO", "commission_amount": float("nan")})
+    assert not allows_risk_increase({"commission_amount": "x"})
+    assert allows_risk_increase({"pnl_status": "SIMULATO", "commission_amount": 1.0})
+
+
+def test_b_target_raggiunto_con_pl_stimato_lo_stop_vale():
+    res, orders = _auto(pnl_status="STIMATO", mm_context={"cycle_active": True, "cycle_id": "c1",
+                        "target_reached": True, "table": {"table_id": 1, "loss_amount": 0.0, "in_recovery": False},
+                        "next_signal": {"market_id": "1.234", "selection_id": 8, "price": 2.0}})
+    assert orders == [] and res["cycle_executor_status"] == "CYCLE_STOPPED_TARGET_REACHED"
+
+
+# ---------------- (c) GUI e Telegram ----------------
+def test_c_gui_storico_mostra_etichetta():
+    import mini_gui
+    assert mini_gui._format_pnl_entry({"net_pnl": 9.55, "pnl_status": "VERIFICATO"}) == "9.55 (VERIFICATO)"
+    assert mini_gui._format_pnl_entry({"net_pnl": -4.0, "payload_json": '{"pnl_status": "SIMULATO"}'}) == "-4.00 (SIMULATO)"
+    assert mini_gui._format_pnl_entry({"net_pnl": 3.0}) == "3.00 (STIMATO)"
+
+
+def test_c_gui_refresh_storico_usa_etichetta():
+    import mini_gui
+    rows = []
+
+    class Tree:
+        def get_children(self): return []
+        def delete(self, *_): pass
+        def insert(self, *_a, values=()): rows.append(values)
+
+    g = object.__new__(mini_gui.MiniPickfairGUI) if hasattr(mini_gui, "MiniPickfairGUI") else None
+    if g is None:
+        pytest.skip("classe GUI non trovata")
+    g.risk_desk_history_tree = Tree()
+    g.uiq = type("Q", (), {"post": staticmethod(lambda f, *a: f(*a))})()
+    g._log = lambda *a: None
+    g.db = type("D", (), {"get_risk_position_history": staticmethod(lambda limit=100: [
