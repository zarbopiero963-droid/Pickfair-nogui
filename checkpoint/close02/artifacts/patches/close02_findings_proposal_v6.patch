+    PROPOSTA close02 F5: rimossa la tolleranza 1e-9 (scelta tecnica PR28),
+    in conflitto con Q3 "nessuna tolleranza". Illeggibile => True (fail-closed)."""
+    a, l = _exact_decimal(amount), _exact_decimal(limit)
+    if a is None or l is None:
+        return True
+    return a >= l
 
 
