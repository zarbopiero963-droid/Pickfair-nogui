+def test_race001_two_connections_same_key_never_silent():
+    """Due istanze Database sullo stesso file; B salva la stessa chiave mentre A è
+    tra lettura e scrittura. Esito ammesso: A fallisce in modo esplicito; mai A
+    che vince in silenzio sopra B."""
+    import threading
+    from database import Database
+    from services.setting_service import SettingsService
+    p = _path(); sa = SettingsService(Database(p)); sb = SettingsService(Database(p))
+    a = sa.load_roserpina_config(); b = sb.load_roserpina_config()
+    a.max_single_bet_pct = 12.5; b.max_single_bet_pct = 7.5
+    orig = sa.db.get_settings; state = {"n": 0}; berr = []
+    def hooked():
+        r = orig(); state["n"] += 1
+        if state["n"] == 2:  # dopo la lettura di 'current' nella transazione di A
+            t = threading.Thread(target=lambda: _try(sb, b, berr)); t.start(); t.join(15)
+        return r
+    sa.db.get_settings = hooked
+    aerr = None
+    try:
+        sa.save_roserpina_config(a)
+    except Exception as e:
+        aerr = e
+    sa.db.get_settings = orig
+    fin = SettingsService(Database(p)).load_roserpina_config().max_single_bet_pct
+    b_ok = not berr; a_ok = aerr is None
+    assert not (a_ok and b_ok), "entrambi riusciti sulla stessa chiave: perdita silenziosa"
+    if a_ok:
+        assert fin == 12.5
+    if b_ok:
+        assert fin == 7.5
+
+
+def _try(s, c, errs):
+    try:
+        s.save_roserpina_config(c)
+    except Exception as e:
+        errs.append(e)
+
+
+# --- RACE-001: criteri t76u ---
+def _raw(s):
