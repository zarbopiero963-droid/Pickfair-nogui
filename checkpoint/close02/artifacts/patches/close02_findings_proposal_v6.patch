+def test_race001_threads_different_keys_no_loss():
+    import threading
+    s = _svc_shared(); cfgs = [s.load_roserpina_config() for _ in range(2)]
+    cfgs[0].max_single_bet_pct = 12.5; cfgs[1].table_count = 3
+    bar = threading.Barrier(2); errs = []
+    def run(c):
+        bar.wait()
+        try: s.save_roserpina_config(c)
+        except Exception as e: errs.append(e)
+    ts = [threading.Thread(target=run, args=(c,)) for c in cfgs]
+    [t.start() for t in ts]; [t.join(10) for t in ts]
+    fin = s.load_roserpina_config()
+    assert not errs and fin.max_single_bet_pct == 12.5 and fin.table_count == 3
