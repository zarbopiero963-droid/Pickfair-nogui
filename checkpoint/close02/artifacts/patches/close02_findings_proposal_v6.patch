+# CL02-BF-001 (root dei 001-004): betfair_market_api, result di tipo inatteso
+@pytest.mark.parametrize("name,args", [
+    ("list_event_types", ()), ("list_competitions", (["1"],)), ("list_events", (["1"],)), ("list_market_catalogue", (["1"],)),
+])
+def test_bf001_market_api_unexpected_result_is_error_not_empty(name, args, tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)  # il modulo apre un FileHandler nella cwd all'import
+    import betfair_market_api as bm
+    with pytest.raises(RuntimeError, match="UNEXPECTED_RESULT"):
+        getattr(_client(ERR_PAYLOAD, bm.MarketBetfairClient), name)(*args)
+
+
+def test_bf001_market_api_legit_empty_stays_empty(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    import betfair_market_api as bm
+    assert _client([], bm.MarketBetfairClient).list_event_types() == []
+    assert _client({}, bm.MarketBetfairClient).list_event_types() == []  # [] dopo _post_jsonrpc
+
