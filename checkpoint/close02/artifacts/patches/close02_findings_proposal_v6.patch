+"""CL02-ENV-001 — fallback Tk senza customtkinter: CTkComboBox(command=...) su
+ttk.Combobox solleva TclError "-command" (mini_gui.py:182-184, chiamata :919-925).
+Dipende dall'ambiente: serve DISPLAY e customtkinter assente."""
+import importlib.util
+import os
+
+import pytest
+
+pytestmark = pytest.mark.skipif(
+    not os.environ.get("DISPLAY") or importlib.util.find_spec("customtkinter") is not None,
+    reason="ENV: richiede DISPLAY e customtkinter assente",
+)
+
+
+def test_env001_fallback_combobox_accepts_command():
+    import tkinter as tk
+    import mini_gui as gui
+    root = tk.Tk()
+    try:
+        var = tk.StringVar(root, "SIMULATION")
+        box = gui.ctk.CTkComboBox(root, variable=var, values=["SIMULATION", "LIVE"], width=140, command=lambda v: None)
+        assert box is not None
+    finally:
+        root.destroy()
