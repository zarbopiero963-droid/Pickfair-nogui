+    b.max_single_bet_pct = 7.5   # chiave in conflitto
+    with pytest.raises(RuntimeError, match="CONFIG_CONFLICT:roserpina.max_single_bet_pct"):
+        s.save_roserpina_config(b)
+    assert _raw(s) == before     # nessuna scrittura parziale, versione invariata
