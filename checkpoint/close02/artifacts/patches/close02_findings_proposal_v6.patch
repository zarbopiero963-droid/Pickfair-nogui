@@ -0,0 +1,383 @@
+"""PF-OWNER-CLOSE-ALL-02 §5 — test RED dei 6 finding di codice @028cee9 (proposta, non su #505).
+
+Regole owner: Q3/Q4 #426/6141450045, Q5 #426/6141136157, limiti 10 € #426/5656005416 e #426/6131980558.
+F1 esposizione solo in %; F2 LAY misurato sullo stake; F3 drawdown in %; F4 drawdown solo LIVE;
+F5 tolleranza 1e-9 sul cap; F6 nessuna versione di configurazione.
+"""
+from __future__ import annotations
+
+import tempfile
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+from core import validators
+from core.runtime_controller import RuntimeController
+from core.system_state import RoserpinaConfig, RuntimeMode, DeskMode
+
+
+# ---------------------------------------------------------------- harness dutching (manual_bet)
+class _Mode:
+    value = "ACTIVE"
+
+
+class _Cfg:
+    anti_duplication_enabled = False
+    allow_recovery = True
+    max_total_exposure_pct = 35.0
+    # Cap monetario configurato: valore campagna #351 (#426/5656005416 P02/P06
+    # "Esposizione complessiva massima EUR 10"), NON costante di codice.
+    max_open_exposure = 10.00
+    max_event_exposure_pct = 18.0
+    max_single_bet_pct = 18.0
+
+
+class _Desk:
+    def __init__(self, bankroll):
+        self.bankroll_current = bankroll
+
+
+class _TM:
+    def __init__(self, exposure=0.0, raises=False):
+        self._e, self._r = exposure, raises
+
+    def total_exposure(self):
+        if self._r:
+            raise RuntimeError("esposizione non verificabile")
+        return self._e
+
+    def find_by_event_key(self, _k):
+        return None
+
+
+class _Bus:
+    def __init__(self):
+        self.published = []
+
+    def publish(self, topic, payload):
+        self.published.append((topic, payload))
+
+
+class _RT:
+    def __init__(self, bankroll=100.0, exposure=0.0, raises=False, **cfg):
+        self.mode = _Mode()
+        self.config = _Cfg()
+        for k, v in cfg.items():
+            setattr(self.config, k, v)
+        self.risk_desk = _Desk(bankroll)
+        self.duplication_guard = None
+        self.table_manager = _TM(exposure, raises)
+        self.dutching_batch_manager = None
+
+
+def _bet(rt, side, stake, price):
+    from controllers.dutching_controller import DutchingController
+
+    bus = _Bus()
+    res = DutchingController(bus=bus, runtime_controller=rt).manual_bet(
+        {"market_id": "1.100", "selection_id": 7, "price": price, "stake": stake, "bet_type": side}
+    )
+    return res, bus
+
+
+# F1 — esposizione in € come capitale a rischio (10,00 €), non solo % del bankroll
+def test_f1_red_exposure_over_10_eur_blocked_even_if_pct_allows():
+    # 9.00 € già a rischio + BACK 2.00 = 11.00 € > 10.00 € ; la % (35% di 100 = 35 €) lo consentirebbe
+    res, bus = _bet(_RT(exposure=9.0), "BACK", 2.0, 2.0)
+    assert res["ok"] is False, "11.00 € di capitale a rischio deve essere bloccato (limite owner 10 €)"
+
+
+def test_f1_boundary_exposure_equal_10_eur_allowed():
+    # Q3: esposizione == cap ammessa
+    res, _ = _bet(_RT(exposure=8.0), "BACK", 2.0, 2.0)
+    assert res["ok"] is True
+
+
+def test_f1_unverifiable_exposure_blocks_new_risk():
+    # Q4: nessun nuovo ordine che aumenta il rischio se l'esposizione non è verificabile
+    res, _ = _bet(_RT(raises=True), "BACK", 1.0, 2.0)
+    assert res["ok"] is False
+
+
+# F2 — LAY: rischio = liability = stake*(quota-1)
+def test_f2_red_lay_measured_as_liability_against_single_cap():
+    # cap singolo 5% di 100 = 5.00 € ; LAY 1.00@10 => liability 9.00 > 5.00 (lo stake 1.00 passerebbe)
+    res, _ = _bet(_RT(max_single_bet_pct=5.0), "LAY", 1.0, 10.0)
+    assert res["ok"] is False
+
+
+def test_f1_cap_comes_from_configuration_not_hardcode():
+    # con cap configurato 20 EUR, 11 EUR passa: nessun 10 EUR cablato nel codice
+    res, _ = _bet(_RT(exposure=9.0, max_open_exposure=20.0, max_single_bet_pct=100.0, max_total_exposure_pct=100.0), "BACK", 2.0, 2.0)
+    assert res.get("ok") is True, res
+
+
+def test_f5_float_sum_at_cap_uses_decimal():
+    assert validators.exceeds_cap(validators.money_sum(0.1, 0.2), 0.3) is False
+    assert validators.order_exposure("LAY", 0.1, 4.0) == 0.3
+
+
+def test_f2_lay_liability_counts_toward_10_eur():
+    # 2.00 € a rischio + LAY 1.00@10 (liability 9.00) = 11.00 € > 10.00 €
+    res, _ = _bet(_RT(exposure=2.0, max_single_bet_pct=100.0, max_total_exposure_pct=100.0), "LAY", 1.0, 10.0)
+    assert res["ok"] is False
+
+
+# ---------------------------------------------------------------- harness runtime (drawdown)
+class _RBus:
+    def __init__(self):
+        self.events = []
+
+    def subscribe(self, *_a):
+        return None
+
+    def publish(self, topic, payload=None):
+        self.events.append((topic, payload or {}))
+
+
+class _DB:
+    def _execute(self, *_a, **_k):
+        return None
+
+    def _fetch_one(self, *_a, **_k):
+        return None
+
+    def _fetch_all(self, *_a, **_k):
+        return []
+
+
+class _Settings:
+    def __init__(self, pct, **extra):
+        self.pct = pct
+        self.extra = extra
+
+    def load_roserpina_config(self):
+        cfg = RoserpinaConfig()
+        cfg.anti_duplication_enabled = False
+        cfg.max_daily_loss = 100.0
+        cfg.max_drawdown_hard_stop_pct = self.pct
+        cfg.max_open_exposure = 250.0
+        for k, v in self.extra.items():
+            setattr(cfg, k, v)
+        return cfg
+
+    def load_market_data_config(self):
+        return {"market_data_mode": "poll", "enabled": False, "market_ids": [], "snapshot_fallback_enabled": True, "snapshot_fallback_interval_sec": 1}
+
+
+class _BF:
+    def set_simulation_mode(self, _e):
+        return None
+
+    def get_account_funds(self):
+        return {"available": 0.0}
+
+    def status(self):
+        return {"connected": True}
+
+    def get_live_client(self):
+        return object()
+
+    def get_market_book_snapshot(self, _m):
+        return None
+
+    def ensure_stream_session_ready(self):
+        return True
+
+
+class _TG:
+    def start(self):
+        return {"started": True}
+
+    def stop(self):
+        return None
+
+    def status(self):
+        return {"connected": True}
+
+
+def _runtime(mode, pct, peak, bankroll, **extra):
+    bus = _RBus()
+    rc = RuntimeController(bus=bus, db=_DB(), settings_service=_Settings(pct, **extra), betfair_service=_BF(), telegram_service=_TG())
+    rc.mode = RuntimeMode.ACTIVE
+    rc.execution_mode = mode
+    if mode == "LIVE":
+        # Harness: il deploy gate reale (NO-GO senza readiness) rifiuterebbe il
+        # segnale PRIMA del controllo drawdown; lo stub isola il punto in esame.
+        rc.enforce_deploy_gate = lambda **_kw: {"allowed": True, "reason": "TEST_STUB", "reasons": []}
+    rc.risk_desk.equity_peak = peak
+    rc.risk_desk.bankroll_current = bankroll
+    rc.mm.calculate = lambda **_kw: type("D", (), {"approved": True, "recommended_stake": 1.0, "table_id": 1, "reason": "ok", "desk_mode": DeskMode.NORMAL, "metadata": {}})()
+    return rc, bus
+
+
+def _drawdown_rejected(bus):
+    return [e for e in bus.events if e[0] == "SIGNAL_REJECTED" and "drawdown" in str(e[1].get("reason", ""))]
+
+
+def _sig():
+    return {"market_id": "1.2", "selection_id": 11, "price": 2.0}
+
+
+# F3 — drawdown vincolante in € assoluti (10,00 €), la % non lo sostituisce
+@pytest.mark.parametrize("mode", ["LIVE"])
+def test_f3_red_drawdown_10_01_eur_stops_even_if_pct_not_reached(mode):
+    rc, bus = _runtime(mode, 20.0, 100.0, 89.99)  # perdita 10.01 € = 10.01% < 20%
+    rc._on_signal_received(_sig())
+    assert _drawdown_rejected(bus), "drawdown 10.01 € deve fermare (Q5)"
+
+
+def test_f3_boundary_drawdown_exactly_10_eur_stops():
+    rc, bus = _runtime("LIVE", 20.0, 100.0, 90.0)  # Q3: stop se perdita >= 10.00
+    rc._on_signal_received(_sig())
+    assert _drawdown_rejected(bus)
+
+
+def test_f3_below_10_eur_no_drawdown_stop():
+    rc, bus = _runtime("LIVE", 20.0, 100.0, 92.0)
+    rc._on_signal_received(_sig())
+    assert not _drawdown_rejected(bus)
+    # il segnale deve aver superato il punto drawdown (test non vacuo)
+    assert not [e for e in bus.events if "deploy_gate" in str(e[1])]
+
+
+# F4 — drawdown anche in SIM
+def test_f4_red_drawdown_applies_in_simulation():
+    rc, bus = _runtime("SIMULATION", 20.0, 100.0, 89.99)
+    rc._on_signal_received(_sig())
+    assert _drawdown_rejected(bus), "Q5: il limite vale in SIM e LIVE"
+
+
+def test_f4_unverifiable_equity_fails_closed():
+    rc, bus = _runtime("SIMULATION", 20.0, float("nan"), 95.0)
+    rc._on_signal_received(_sig())
+    assert not [e for e in bus.events if e[0] == "CMD_QUICK_BET"], "equity non verificabile => nessun nuovo rischio"
+
+
+# F5 — nessuna tolleranza numerica sul cap
+def test_f5_red_amount_above_cap_by_less_than_1e9_exceeds():
+    assert validators.exceeds_cap(10.000000001, 10.0) is True
+
+
+def test_f5_equality_allowed_and_one_cent_over_blocked():
+    assert validators.exceeds_cap(Decimal("10.00"), Decimal("10.00")) is False
+    assert validators.exceeds_cap(Decimal("10.01"), Decimal("10.00")) is True
+
+
+def test_f5_decimal_sum_exact_at_cap():
+    total = Decimal("0.1") + Decimal("0.2")
+    assert validators.exceeds_cap(total, Decimal("0.3")) is False
+
+
+# F6 — versione di configurazione salvata insieme ai valori
+def test_f6_red_config_version_persisted_and_incremented():
+    from database import Database
+    from services.setting_service import SettingsService
