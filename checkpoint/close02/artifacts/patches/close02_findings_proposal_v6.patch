+# --- RACE-001: crash/recovery e concorrenza (t75u) ---
+def _path():
+    return os.path.join(tempfile.mkdtemp(), "r.sqlite")
+
+
+def test_race001_crash_mid_save_is_atomic_and_recovers():
+    from database import Database
+    from services.setting_service import SettingsService
+    p = _path(); db = Database(p); s = SettingsService(db)
+    a = s.load_roserpina_config(); a.max_single_bet_pct = 12.5; s.save_roserpina_config(a)
+    v0 = db.get_settings().get("roserpina.config_version")
+    b = s.load_roserpina_config(); b.max_single_bet_pct = 9.0; b.table_count = 4
+    orig = db._set_setting; n = {"c": 0}
+    def boom(k, v):
+        n["c"] += 1
+        if n["c"] == 2:
+            raise OSError("crash simulato a metà salvataggio")
+        return orig(k, v)
+    db._set_setting = boom
+    with pytest.raises(OSError):
+        s.save_roserpina_config(b)
+    db._set_setting = orig
+    s2 = SettingsService(Database(p))  # riavvio
+    fin = s2.load_roserpina_config()
+    assert fin.max_single_bet_pct == 12.5 and fin.table_count != 4
+    assert s2.db.get_settings().get("roserpina.config_version") == v0
+    b2 = s2.load_roserpina_config(); b2.table_count = 4; s2.save_roserpina_config(b2)
+    assert s2.load_roserpina_config().table_count == 4
+
