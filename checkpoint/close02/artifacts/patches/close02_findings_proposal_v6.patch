+
+ERR_PAYLOAD = {"faultcode": "Client", "detail": {"APINGException": {"errorCode": "INVALID_SESSION_INFORMATION"}}}
+
+
+def _client(ret, cls=bc.BetfairClient):
+    o = object.__new__(cls)
+
+    def post(self, url, method, params, *a, **k):
+        return ret
+
+    o._post_jsonrpc = types.MethodType(post, o)
+    o.BETTING_URL = "https://betting.invalid"
+    o.ACCOUNT_URL = "https://account.invalid"
+    return o
