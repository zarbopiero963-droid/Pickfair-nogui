@@ -0,0 +1,44 @@
+"""close02 v17 (Claude) — CL16-MINSTAKE-001: nessun aumento automatico dello stake per raggiungere il minimo.
+
+Regola owner (decisione Small Bet, #506/6114505989 dell'11/10/2026, e #426/6068305820): «non aumentare
+automaticamente stake/liability per raggiungere un minimo»; un ordine sotto il minimo si rifiuta (fail-closed),
+non si gonfia. Prima della correzione il money management portava 0,30 EUR a 0,50 EUR (`_clamp` verso l'alto).
+Fixture sintetiche, catena reale (RuntimeController + money management VERO + SimulationBroker), nessuna rete."""
+from decimal import Decimal
+
+import pytest
+
+from tests.acceptance.test_issue437_pr27 import _catena, _rifiuti
+from tests.integration.test_issue461_pr26a_customer_ref_provenance import _signal
+
+
+def _ordini(c):
+    return [Decimal(str(o.get("size") if isinstance(o, dict) else getattr(o, "size"))) for o in c.broker.state.orders.values()]
+
+
+def _run(tmp_path, stake, min_stake="0.50"):
+    c = _catena(tmp_path)
+    c.rc.config.max_open_exposure = 10.0
+    c.rc.config.min_stake = float(min_stake)
+    c.rc._on_signal_received(_signal(stake=stake, bet_type="BACK"))
+    return c
+
+
+@pytest.mark.parametrize("stake", [0.30, 0.49])
+def test_stake_sotto_minimo_rifiutato_senza_aumento(tmp_path, stake):
+    c = _run(tmp_path, stake)
+    assert _ordini(c) == []
+    assert c.bus.payloads("CMD_QUICK_BET") == []
+    assert _rifiuti(c) and _rifiuti(c)[0].startswith("stake_sotto_minimo"), _rifiuti(c)
+
+
+@pytest.mark.parametrize("stake,atteso", [(0.50, "0.5"), (0.60, "0.6")])
+def test_stake_al_o_sopra_minimo_inviato_invariato(tmp_path, stake, atteso):
+    c = _run(tmp_path, stake)
+    assert _ordini(c) == [Decimal(atteso)]
+    assert _rifiuti(c) == []
+
+
+def test_small_bet_dieci_centesimi_ammessa_con_minimo_dieci_centesimi(tmp_path):
+    c = _run(tmp_path, 0.10, min_stake="0.10")
+    assert _ordini(c) == [Decimal("0.1")]
