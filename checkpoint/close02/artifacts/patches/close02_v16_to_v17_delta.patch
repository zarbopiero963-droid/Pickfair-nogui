+def test_tiny_bankroll_stake_below_minimum_is_rejected_not_raised():
+    """close02 v17 (CL16-MINSTAKE-001, owner #506/6114505989): stake calcolato
+    0.009 sotto min_stake => rifiuto, mai portato al minimo."""
+    mm = _mm()
