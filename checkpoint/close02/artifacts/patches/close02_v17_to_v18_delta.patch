@@ -0,0 +1,215 @@
+"""Esposizione degli ordini remoti ritrovati al riavvio (PROPOSTA close02 v18, CL17-RST-GHOST-001).
+
+Dopo un riavvio i tavoli del processo sono vuoti, ma sull'exchange possono restare ordini del
+processo precedente (ingressi abbinati non ancora regolati, hedge di cashout a riposo). Senza
+questo registro la loro esposizione vale 0 nei cap e un nuovo ingresso passa oltre il tetto.
+
+Regole applicate (owner #426/6124156631):
+- OWNER-EXPOSURE-01: caso peggiore NETTO per mercato sugli esiti mutuamente esclusivi
+  (ogni selezione presente vince, oppure nessuna di esse); parte abbinata e residuo a
+  riposo; liability BACK e LAY; arrotondamento conservativo al centesimo per eccesso;
+  un ordine non modellabile (lato ignoto, prezzo/importi non finiti, handicap) rende
+  l'esposizione del suo mercato infinita: il calcolo fallisce in sicurezza.
+- OWNER-SETTLEMENT-02: nessun blocco permanente e nessun rilascio di capitale impegnato.
+  Un ordine esce dal registro solo quando una lettura COMPLETA e RIUSCITA degli ordini
+  correnti del suo mercato non lo contiene piu': su Betfair un ordine resta fra i
+  correnti (anche EXECUTION_COMPLETE) finche' il mercato non e' regolato, quindi la sua
+  assenza significa che non c'e' piu' capitale impegnato sull'exchange. Lettura fallita
+  => il registro resta com'e' (fail-closed).
+
+Il P/L realizzato di questi ordini resta al poller dei settlement (cleared orders): questo
+modulo misura solo il rischio aperto.
+"""
+from __future__ import annotations
+
+import math
+import threading
+from decimal import ROUND_CEILING, Decimal, InvalidOperation
+from typing import Any, Dict, Iterable, List, Optional
+
+_CENT = Decimal("0.01")
+_UNKNOWN_MARKET = "?"
+
+
+def _num(row: Dict[str, Any], *keys: str) -> Optional[Decimal]:
+    """Primo valore numerico finito fra le chiavi; None se assente; NaN se illeggibile."""
+    for key in keys:
+        if key in row and row[key] is not None:
+            value = row[key]
+            if isinstance(value, bool):
+                return Decimal("NaN")
+            try:
+                dec = Decimal(str(value))
+            except (InvalidOperation, ValueError):
+                return Decimal("NaN")
+            return dec if dec.is_finite() else Decimal("NaN")
+    return None
+
+
+def _price_size(row: Dict[str, Any]) -> Dict[str, Any]:
+    ps = row.get("priceSize")
+    return ps if isinstance(ps, dict) else {}
+
+
+def normalize_order(row: Any) -> Optional[Dict[str, Any]]:
+    """Riduce una riga di listCurrentOrders (camelCase o snake_case) alla forma del calcolo.
+
+    Ritorna ``{"bet_id", "market_id", "selection_id", "side", "matched", "avg_price",
+    "remaining", "price"}`` oppure ``None`` se la riga non e' modellabile."""
+    if not isinstance(row, dict):
+        return None
+    ps = _price_size(row)
+    side = str(row.get("side") or row.get("bet_type") or "").strip().upper()
+    sel = str(row.get("selectionId") or row.get("selection_id") or "").strip()
+    market = str(row.get("marketId") or row.get("market_id") or "").strip()
+    handicap = _num(row, "handicap")
+    price = _num(ps, "price")
+    if price is None:
+        price = _num(row, "price")
+    size = _num(ps, "size")
+    if size is None:
+        size = _num(row, "size")
+    matched = _num(row, "sizeMatched", "size_matched", "matched_size")
+    remaining = _num(row, "sizeRemaining", "size_remaining")
+    avg = _num(row, "averagePriceMatched", "average_price_matched")
+    if matched is None:
+        matched = Decimal(0)
+    if remaining is None:
+        remaining = (size - matched) if size is not None and size.is_finite() else None
+    values = (price, matched, remaining)
+    if (side not in ("BACK", "LAY") or not sel or not market
+            or any(v is None or not v.is_finite() for v in values)
+            or (handicap is not None and (not handicap.is_finite() or handicap != 0))
+            or matched < 0 or remaining < 0 or price <= 1
+            or (avg is not None and (not avg.is_finite() or (matched > 0 and avg <= 1)))):
+        return None
+    if avg is None or avg <= 1:
+        avg = price
+    return {"bet_id": str(row.get("betId") or row.get("bet_id") or "").strip(),
+            "market_id": market, "selection_id": sel, "side": side,
+            "matched": matched, "avg_price": avg, "remaining": remaining, "price": price}
+
+
+def market_worst_case(orders: Iterable[Dict[str, Any]]) -> Decimal:
+    """Perdita massima netta (>= 0) di un mercato, su ordini gia' normalizzati.
+
+    Esiti: ogni selezione presente vince (le altre perdono) oppure nessuna vince. Per la
+    parte abbinata il contributo e' certo; per il residuo a riposo si prende il peggiore
+    fra "non si abbina" (0) e "si abbina per intero" (lineare nell'abbinato => estremi)."""
+    rows = list(orders)
+    selections = sorted({o["selection_id"] for o in rows})
+    worst = Decimal(0)
+    for winner in selections + [None]:
+        pnl = Decimal(0)
+        for o in rows:
+            wins = o["selection_id"] == winner
+            m, r = o["matched"], o["remaining"]
+            if o["side"] == "BACK":
+                # vincita al prezzo piu' basso fra medio e limite: guadagno sotto-stimato
+                low = min(o["avg_price"], o["price"])
+                pnl += m * (low - 1) if wins else -m
+                pnl += Decimal(0) if wins else -r
+            else:
+                # liability al prezzo piu' alto fra medio e limite: perdita sovra-stimata
+                high = max(o["avg_price"], o["price"])
+                pnl += -m * (high - 1) if wins else m
+                pnl += -r * (o["price"] - 1) if wins else Decimal(0)
+        worst = max(worst, -pnl)
+    return worst.quantize(_CENT, rounding=ROUND_CEILING)
+
+
+class RemoteExposureRegistry:
+    """Registro thread-safe degli ordini remoti non tracciati dai tavoli di questo processo."""
+
+    def __init__(self) -> None:
+        self._lock = threading.RLock()
+        self._orders: Dict[str, Dict[str, Any]] = {}  # bet_id -> ordine normalizzato
+        self._unmodeled: Dict[str, int] = {}  # market_id (o "?") -> righe non modellabili
+
+    def seed(self, rows: Iterable[Any]) -> None:
+        with self._lock:
+            self._orders.clear()
+            self._unmodeled.clear()
+            for row in rows or []:
+                self._add(row)
+
+    def _add(self, row: Any) -> None:
+        norm = normalize_order(row)
+        if norm is None or not norm["bet_id"]:
+            market = ""
+            if isinstance(row, dict):
+                market = str(row.get("marketId") or row.get("market_id") or "").strip()
+            key = market or _UNKNOWN_MARKET
+            self._unmodeled[key] = self._unmodeled.get(key, 0) + 1
+            return
+        self._orders[norm["bet_id"]] = norm
+
+    def empty(self) -> bool:
+        with self._lock:
+            return not self._orders and not self._unmodeled
+
+    def markets(self) -> List[str]:
+        with self._lock:
+            return sorted({o["market_id"] for o in self._orders.values()} | set(self._unmodeled))
+
+    def bet_ids(self) -> List[str]:
+        with self._lock:
+            return sorted(self._orders)
+
+    def market_exposure(self, market_id: str) -> float:
+        with self._lock:
+            if market_id in self._unmodeled or _UNKNOWN_MARKET in self._unmodeled:
+                return math.inf
+            rows = [o for o in self._orders.values() if o["market_id"] == market_id]
+            return float(market_worst_case(rows)) if rows else 0.0
+
+    def total(self) -> float:
+        with self._lock:
+            if self._unmodeled:
+                return math.inf
+            total = Decimal(0)
+            for market in {o["market_id"] for o in self._orders.values()}:
+                total += market_worst_case(o for o in self._orders.values() if o["market_id"] == market)
+            return float(total)
+
+    def refresh(self, snapshot: Iterable[Any], markets: Optional[List[str]]) -> List[str]:
+        """Aggiorna con una lettura COMPLETA e RIUSCITA dei correnti di ``markets``.
+
+        ``markets=None`` significa lettura di tutto il conto. Gli ordini del registro ancora
+        presenti vengono aggiornati; quelli assenti escono (nessun capitale impegnato). Le
+        righe non tracciate qui (ordini nuovi di questo processo) sono ignorate: le contano
+        i tavoli. Ritorna i bet_id rilasciati."""
+        rows = [r for r in (snapshot or []) if isinstance(r, dict)]
+        scope = None if markets is None else {str(m) for m in markets}
+        with self._lock:
+            by_id = {str(r.get("betId") or r.get("bet_id") or "").strip(): r for r in rows}
+            released = []
+            for bet_id, old in list(self._orders.items()):
+                if scope is not None and old["market_id"] not in scope:
+                    continue
+                fresh = by_id.get(bet_id)
+                if fresh is None:
+                    released.append(bet_id)
+                    self._orders.pop(bet_id, None)
+                    continue
+                norm = normalize_order(fresh)
+                if norm is None or not norm["bet_id"]:
+                    self._orders.pop(bet_id, None)
+                    key = old["market_id"]
+                    self._unmodeled[key] = self._unmodeled.get(key, 0) + 1
+                else:
+                    self._orders[bet_id] = norm
+            # Righe non modellabili: si sciolgono solo se la lettura del loro mercato (o del
+            # conto intero per "?") non contiene piu' righe non identificabili/non modellabili.
+            for key in list(self._unmodeled):
+                if scope is not None and key not in scope:
+                    continue
+                if key == _UNKNOWN_MARKET and scope is not None:
+                    continue
+                bad = [r for r in rows
+                       if (key == _UNKNOWN_MARKET or str(r.get("marketId") or r.get("market_id") or "").strip() == key)
+                       and (normalize_order(r) is None
+                            or not str(r.get("betId") or r.get("bet_id") or "").strip())]
+                if not bad:
+                    self._unmodeled.pop(key, None)
+            return released
