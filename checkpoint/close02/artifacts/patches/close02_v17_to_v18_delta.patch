+    def _open_exposure_total(self, refresh: bool = False) -> float:
+        """Esposizione aperta per i cap: tavoli di questo processo + ordini remoti ritrovati
+        al riavvio (PROPOSTA close02 v18, CL17-RST-GHOST-001). Mai sotto-stimata: un valore
+        non finito di uno dei due addendi rende infinito il totale (fail-closed)."""
