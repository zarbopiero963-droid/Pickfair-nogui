+        remote = registry.total() if registry is not None else 0.0
+        if not (math.isfinite(tables) and math.isfinite(remote)):
+            return float("inf")
+        return float(validators.money_sum(tables, remote))
+
+    def _refresh_remote_exposure(self) -> None:
+        """Rilettura dei correnti dei mercati con ordini remoti (OWNER-SETTLEMENT-02).
+
+        Solo una lettura riuscita aggiorna/rilascia; un errore lascia il registro intatto
+        (nessun rilascio di capitale ancora impegnato)."""
+        registry = getattr(self, "remote_exposure", None)
+        if registry is None or registry.empty():
+            return
+        markets = registry.markets()
+        scope = None if "?" in markets else markets
+        try:
+            snapshot = self.betfair_service.list_current_orders(market_ids=scope)
+        except Exception as exc:
+            logger.warning("Esposizione remota: lettura correnti fallita, nessun rilascio (%s)", exc)
+            return
+        if not isinstance(snapshot, list):
+            logger.warning("Esposizione remota: risposta correnti non valida, nessun rilascio")
+            return
+        released = registry.refresh(snapshot, scope)
+        if released:
+            self.bus.publish("REMOTE_EXPOSURE_RELEASED", {"bet_ids": list(released),
+                                                         "remaining_total": registry.total()})
+
