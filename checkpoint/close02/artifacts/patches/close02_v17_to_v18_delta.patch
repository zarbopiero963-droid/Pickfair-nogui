+               sizeRemaining=0.0, averagePriceMatched=5.0)
+    back = dict(B1, betId="100000000011", priceSize={"price": 4.0, "size": 3.0}, sizeMatched=0.0,
+                sizeRemaining=3.0, averagePriceMatched=0.0)
