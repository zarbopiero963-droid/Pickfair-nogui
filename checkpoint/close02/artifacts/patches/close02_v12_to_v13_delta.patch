+def test_c2b_cli_mostra_e_richiede_conferma_digitata(tmp_path, monkeypatch):
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("cli_mig", os.path.join(ROOT, "scripts", "pre_v9_migration.py"))
