@@ -0,0 +1,283 @@
+"""close02 v13 — migrazione pre-v9 ratificata dall'owner (#426, opzione A).
+Un test per condizione del testo owner. RED sul patch v12, GREEN col patch v13."""
+import json, os, signal, subprocess, sys, textwrap
+import pytest
+from database import Database
+from tests.close02.test_close02_restart_t81u import ROOT, _run_and_kill, _restart, _blocked, _set_raw, _order_calls
+
+LEDGER_KEY, PEAK_KEY = "risk.persist_ledger", "risk.equity_peak_eur"
+
+
+def _mig():
+    from core import pre_v9_migration
+    return pre_v9_migration
+
+
+def _settings(p):
+    return Database(p).get_settings()
+
+
+def _pre_v9(tmp_path, name="m.sqlite", action="none", keep_peak=True):
+    """Stato tipo pre-v9: storia di rischio, registro protezioni assente."""
+    p = str(tmp_path / name)
+    _run_and_kill(p, action=action)
+    _set_raw(p, LEDGER_KEY, None)
+    for f in os.listdir(tmp_path):
+        if f.endswith(".risk_ledger.json") or (not keep_peak and f.endswith(".equity_peak.json")):
+            os.remove(tmp_path / f)
+    if not keep_peak:
+        _set_raw(p, PEAK_KEY, None)
+    return p
+
+
+def _first_boot(p, monkeypatch):
+    """Primo avvio v9+: marca REINIT_REQUIRED (stato visto dall'operatore)."""
+    return _restart(p, monkeypatch, 1000.0)
+
+
+def _ratify(p, operatore="operatore-test"):
+    m = _mig()
+    db = Database(p)
+    rep = m.inspect(db)
+    return m.ratify(db, operatore=operatore, digest=rep["digest"]), rep
+
+
+# C1 prima della migrazione: non operativo per ogni nuovo rischio (anche col picco presente)
+def test_c1_prima_della_migrazione_nuovo_rischio_bloccato(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path)
+    rc, rej = _first_boot(p, monkeypatch)
+    assert _blocked(rc) and any("migrazione_pre_v9_richiesta" in r for r in rej), rej
+    rc2, rej2 = _restart(p, monkeypatch, 1000.0)
+    assert _blocked(rc2), rej2
+
+
+# C2 l'operatore vede valori persistiti, provenienza, risk-stop, emergenza, ordini incerti
+def test_c2_report_mostra_valori_provenienza_riskstop_ordini(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path); _first_boot(p, monkeypatch)
+    rep = _mig().inspect(Database(p))
+    peak = {c["provenienza"]: c for c in rep["valori"]["equity_peak"]}
+    assert peak["db:" + PEAK_KEY]["grezzo"] == _settings(p)[PEAK_KEY] and peak["db:" + PEAK_KEY]["valore"] == 1000.0
+    assert {c["provenienza"] for c in rep["valori"]["daily_loss"]} == {"db:daily_loss_state", "file:.daily_loss_pending.json"}
+    assert set(rep["risk_stop"]) == {"motivo_attivo", "copie"} and "emergenza" in rep
+    assert rep["ordini_incerti"] == [] and rep["ordini_leggibili"] is True
+    assert rep["migrazione_richiesta"] is True and rep["bloccanti"] == [] and len(rep["digest"]) == 64
+
+
+# C3 dato indispensabile mancante: nessun valore inventato, resta bloccato
+def test_c3_picco_mancante_resta_bloccato_e_nulla_e_inventato(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path, keep_peak=False); _first_boot(p, monkeypatch)
+    res, _ = _ratify(p)
+    assert not res["ok"] and "equity_peak_mancante" in res["motivo"]
+    assert PEAK_KEY not in _settings(p) and not any(f.endswith(".equity_peak.json") for f in os.listdir(tmp_path))
+    assert "ledger_reinit_required" in json.loads(_settings(p)[LEDGER_KEY])
+    rc, rej = _restart(p, monkeypatch, 1000.0)
+    assert _blocked(rc), rej
+
+
+def test_c4_daily_loss_mancante_resta_bloccato(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path); _first_boot(p, monkeypatch)
+    _set_raw(p, "daily_loss_state", None)
+    for f in os.listdir(tmp_path):
+        if f.endswith(".daily_loss_pending.json"):
+            os.remove(tmp_path / f)
+    res, _ = _ratify(p)
+    assert not res["ok"] and "daily_loss_mancante" in res["motivo"]
+
+
+# C5 verificabile: copie illeggibili => bloccato
+def test_c5_copia_illeggibile_resta_bloccato(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path); _first_boot(p, monkeypatch)
+    _set_raw(p, PEAK_KEY, "{rotto")
+    res, _ = _ratify(p)
+    assert not res["ok"] and "equity_peak_illeggibile" in res["motivo"]
+
+
+# C6 coerente: copie DB/file divergenti => bloccato (nessuna scelta arbitraria)
+def test_c6_copie_incoerenti_resta_bloccato(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path); _first_boot(p, monkeypatch)
+    f = [x for x in os.listdir(tmp_path) if x.endswith(".equity_peak.json")][0]
+    (tmp_path / f).write_text(json.dumps({"peak": 1200.0}))
+    res, _ = _ratify(p)
+    assert not res["ok"] and "equity_peak_copie_incoerenti" in res["motivo"]
+
+
+# C7 ordini incerti => riconciliazione documentata richiesta
+def test_c7_ordini_incerti_richiedono_riconciliazione(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path); _first_boot(p, monkeypatch)
+    Database(p).create_order_saga(customer_ref="CR-1", batch_id="B1", event_key="E1", table_id=1,
+                                  market_id="1.5", selection_id=1, bet_type="BACK", price=2.0, stake=2.0,
+                                  payload={}, status="SUBMITTED")
+    rep = _mig().inspect(Database(p))
+    assert rep["ordini_incerti"] and rep["ordini_incerti"][0]["customer_ref"] == "CR-1"
+    res, _ = _ratify(p)
+    assert not res["ok"] and "ordini_incerti_riconciliazione_richiesta" in res["motivo"]
+
+
+# C8 manuale: la conferma vale solo per lo stato effettivamente mostrato
+def test_c8_digest_diverso_rifiutato_e_operatore_obbligatorio(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path); _first_boot(p, monkeypatch)
+    m = _mig(); db = Database(p)
+    assert m.ratify(db, operatore="op", digest="0" * 64)["motivo"] == "digest_non_corrispondente"
+    assert m.ratify(db, operatore=" ", digest=m.inspect(db)["digest"])["motivo"] == "operatore_mancante"
+    assert "ledger_reinit_required" in json.loads(_settings(p)[LEDGER_KEY])
+
+
+# C9 sblocco solo se completo/coerente/verificabile; valori monetari invariati; audit
+def test_c9_sblocco_valori_invariati_e_audit(tmp_path, monkeypatch):
+    p = _pre_v9(tmp_path); _first_boot(p, monkeypatch)
+    before = {k: _settings(p).get(k) for k in (PEAK_KEY, "daily_loss_state", "risk_stop_state")}
+    res, rep = _ratify(p)
+    assert res["ok"], res["motivo"]
+    after = {k: _settings(p).get(k) for k in before}
+    assert after == before
+    led = json.loads(_settings(p)[LEDGER_KEY])
+    assert "ledger_reinit_required" not in led and "pre_v9_migrated" in led
+    audit = [json.loads(x) for x in open(p + ".pre_v9_migration.audit.jsonl", encoding="utf-8")]
+    assert [a["esito"] for a in audit] == ["INTENTO", "COMPLETATA"] and audit[0]["operatore"] == "operatore-test"
+    assert json.loads(_settings(p)["risk.pre_v9_migration"])["esito"] == "COMPLETATA"
+    rc, rej = _restart(p, monkeypatch, 1000.0)
+    assert not _blocked(rc), rej
+
+
+# C10 la conferma non disarma un risk-stop attivo ne' un'emergenza
+@pytest.mark.parametrize("action", ["risk_stop", "emergenza"])
+def test_c10_riskstop_ed_emergenza_restano_attivi(tmp_path, monkeypatch, action):
+    p = _pre_v9(tmp_path, action=action); _first_boot(p, monkeypatch)
