+++ b/tests/close02/test_close02_v12.py
@@ -0,0 +1,124 @@
+"""close02 v12 — owner t80u regola (3): (a) protezioni sul netto conservativo con
+commissione stimata (limite massimo documentato Betfair Italia 4,5% + arrotondamento);
+(b) verifica da rollup MARKET disabilitata finche' la semantica betIds+groupBy non e'
+confermata da fonte pubblica. RED a 028cee9, GREEN col patch."""
+import pytest
+from tests.integration.test_runtime_controller_auto_trade_mm import _make_controller, _canonical_close_payload
+from core.system_state import RuntimeMode
+
+
+def _cp():
+    from core import pnl_label
+    return pnl_label.conservative_pnl
+
+
+@pytest.mark.parametrize("data,net,atteso", [
+    ({"pnl_status": "STIMATO", "gross_pnl": 100.0, "commission_amount": 4.5}, 95.5, 95.49),   # 100-4.5-0.01
+    ({"pnl_status": "STIMATO", "gross_pnl": 100.0, "commission_amount": 2.0}, 98.0, 95.49),   # stima bassa => limite documentato
+    ({"pnl_status": "VERIFICATO", "gross_pnl": 100.0, "commission_amount": 4.5}, 95.5, 95.5),
+    ({"pnl_status": "SIMULATO", "gross_pnl": 100.0, "commission_amount": 4.5}, 95.5, 95.5),
+    ({"pnl_status": "STIMATO", "gross_pnl": -10.0, "commission_amount": 0.0,
+      "market_commission_amount_total": 0.0}, -10.0, -10.0),
+    ({"pnl_status": "STIMATO", "commission_amount": 4.5}, 95.5, 0.0),                          # lordo assente => vincita a rischio
+    ({"pnl_status": "STIMATO", "gross_pnl": "x", "commission_amount": 4.5}, 95.5, 0.0),
+    ({"pnl_status": "STIMATO", "gross_pnl": 100.0, "commission_amount": 4.5}, float("nan"), 0.0),
+    ({"pnl_status": "STIMATO", "gross_pnl": 0.005, "commission_amount": 0.0001}, 0.0049, 0.0),     # margine > vincita => 0, mai negativo
+    ({"pnl_status": "STIMATO", "gross_pnl": 0.2, "commission_amount": 0.01}, 0.19, 0.181),    # 0.2-0.009-0.01
+])
+def test_a_netto_conservativo(data, net, atteso):
+    assert _cp()(data, net) == pytest.approx(atteso, abs=1e-9)
+
+
+def _close(rc, **over):
+    p = _canonical_close_payload(event_key="e-" + str(len(over)), correlation_id="c-" + str(id(over)))
+    p.update(over)
+    rc._on_close_position(p)
+
+
+def test_a_daily_loss_non_compensato_da_vincita_stimata():
+    """Perdita 10 poi vincita stimata lorda 10 (netto stimato 9.55): il daily-loss
+    conta la vincita al netto conservativo 9.54, non 9.55."""
+    rc, _ = _make_controller(responses=[{"available": 150.0}] * 4)
+    rc.mode = RuntimeMode.ACTIVE
+    _close(rc, gross_pnl=-10.0, commission_amount=0.0, net_pnl=-10.0, pnl=-10.0, pnl_status="VERIFICATO",
+           event_key="e1", correlation_id="c1", batch_id="b1")
+    _close(rc, gross_pnl=10.0, commission_amount=0.45, net_pnl=9.55, pnl=9.55, pnl_status="STIMATO",
+           event_key="e2", correlation_id="c2", batch_id="b2")
+    assert rc.risk_desk.realized_pnl == pytest.approx(-10.0 + 9.54)
+
+
+def test_a_daily_loss_vincita_verificata_conta_intera():
+    rc, _ = _make_controller(responses=[{"available": 150.0}] * 4)
+    rc.mode = RuntimeMode.ACTIVE
+    _close(rc, gross_pnl=10.0, commission_amount=0.45, net_pnl=9.55, pnl=9.55, pnl_status="VERIFICATO",
+           event_key="e3", correlation_id="c3", batch_id="b3")
+    assert rc.risk_desk.realized_pnl == pytest.approx(9.55)
+
+
+def test_a_breach_daily_loss_scatta_col_netto_conservativo():
+    """Limite 10: vincita stimata lorda 0.44 (commissione di policy 0.0198 => netto
+    0.4202), poi perdita 10.415. Col netto stimato la perdita e' 9.9948 (< 10, nessuno
+    stop); col conservativo 0.44-0.0198-0.01=0.4102 => 10.0048 >= 10 => stop."""
+    rc, _ = _make_controller(responses=[{"available": 150.0}] * 4)
+    rc.mode = RuntimeMode.ACTIVE
+    rc.config.max_daily_loss = 10.0
+    _close(rc, gross_pnl=0.44, commission_amount=0.0198, net_pnl=0.4202, pnl=0.4202, pnl_status="STIMATO",
+           event_key="e4", correlation_id="c4", batch_id="b4")
+    _close(rc, gross_pnl=-10.415, commission_amount=0.0, net_pnl=-10.415, pnl=-10.415, pnl_status="VERIFICATO",
+           event_key="e5", correlation_id="c5", batch_id="b5")
+    state = dict(rc._daily_loss_monitor_state or {})
+    assert state.get("daily_loss_amount", 0.0) >= 10.0 and bool(state.get("breached"))
+
+
+def test_a_drawdown_usa_il_saldo_verificato_non_il_pl_stimato():
+    """Il drawdown usa picco e bankroll dal saldo Betfair (get_account_funds): una
+    vincita con commissione stimata non sposta ne' il bankroll ne' il picco."""
+    rc, _ = _make_controller(responses=[{"available": 100.0}] * 4)
+    rc.mode = RuntimeMode.ACTIVE
+    rc.risk_desk.equity_peak = 0.0
+    rc.risk_desk.sync_bankroll(100.0)
+    peak = rc.risk_desk.equity_peak
+    rc._apply_realized_pnl_without_mutating_bankroll(50.0)
+    assert rc.risk_desk.bankroll_current == 100.0 and rc.risk_desk.equity_peak == peak == 100.0
+
+
+# ---------------- (b) rollup MARKET non confermato => STIMATO ----------------
+def test_b_default_rollup_non_usato_e_pl_stimato():
+    from tests.close02.test_close02_v11 import _BF, BET, _mkt
+    from tests.core.test_settlement_poller import _controller, _closes
+    rc = _controller(results=[])
+    rc.betfair_service = _BF([BET], [_mkt()])
+    rc._poll_cleared_settlements()
+    closes = _closes(rc)
+    assert closes and closes[-1]["pnl_status"] == "STIMATO"
+    assert not [c for c in rc.betfair_service.calls if c.get("group_by") == "MARKET"]
+    import core.runtime_controller as m
+    assert getattr(m, "CLEARED_MARKET_ROLLUP_VERIFIES", None) is False
+
+
+def test_a_pending_stop_armato_prima_dell_apply_col_netto_conservativo():
+    """Il pending-stop durevole (DAILY_LOSS_BREACH_PENDING) va armato PRIMA dell'I/O
+    del sync, valutando la proiezione sul netto conservativo (non sul netto stimato)."""
+    rc2, _ = _make_controller(responses=[{"available": 150.0}] * 4)
+    rc2.mode = RuntimeMode.ACTIVE
+    rc2.config.max_daily_loss = 10.0
+    rc2.risk_desk.realized_pnl = -10.415
+    seen = []
+    o2 = rc2._persist_db_emergency_marker
+    rc2._persist_db_emergency_marker = lambda **kw: (seen.append(str(kw.get("reason", ""))), o2(**kw))[1]
+    _close(rc2, gross_pnl=0.44, commission_amount=0.0198, net_pnl=0.4202, pnl=0.4202, pnl_status="STIMATO",
+           event_key="e7", correlation_id="c7", batch_id="b7")
+    assert any(r.startswith("DAILY_LOSS_BREACH_PENDING") for r in seen), seen
+
+
+def test_a_hook_picco_non_chiamato_dal_pl_transitorio():
+    """Il rimbalzo transitorio di apply_closed_pnl non deve persistere un nuovo picco."""
+    rc, _ = _make_controller(responses=[{"available": 100.0}] * 4)
+    rc.mode = RuntimeMode.ACTIVE
+    rc.risk_desk.equity_peak = 0.0
+    rc.risk_desk.sync_bankroll(100.0)
+    peaks = []
+    rc.risk_desk.on_new_peak = lambda *a, **k: peaks.append(a or k)
+    _close(rc, gross_pnl=10.0, commission_amount=0.45, net_pnl=9.55, pnl=9.55, pnl_status="STIMATO",
+           event_key="e8", correlation_id="c8", batch_id="b8")
+    assert peaks == [] and rc.risk_desk.equity_peak == pytest.approx(100.0), peaks
