index 0e19a28..e9507e2 100644
--- a/core/pnl_label.py
+++ b/core/pnl_label.py
@@ -53,3 +53,35 @@ def allows_risk_increase(data: Mapping[str, Any] | None) -> bool:
     amount = _num(data, "commission_amount")
     total = _num(data, "market_commission_amount_total")
     return amount is not None and total is not None and amount == 0.0 and total == 0.0
+
+
+# v12 — protezioni (daily-loss) con netto CONSERVATIVO se la commissione e' stimata.
+# Fonte documentata (Betfair Italia, support.betfair.it a_id 3754): "Il tasso base
+# di mercato (Market Base Rate, MBR) e' la commissione massima applicata su un
+# particolare mercato, che in Italia e' pari al 4,5%" ... "L'importo della
+# commissione da pagare e' arrotondato alle due cifre decimali piu' vicine. Per
+# importi che terminano in 0,005 e' prevista un'approssimazione per eccesso."
+# => limite superiore: 4,5% della vincita lorda + 0,01 EUR di margine di arrotondamento.
+BETFAIR_ITALY_MAX_COMMISSION_PCT = 4.5
+ROUNDING_MARGIN_EUR = 0.01
+
+
+def conservative_pnl(data: Mapping[str, Any] | None, net_pnl: Any) -> float:
+    """Netto da usare per le PROTEZIONI. Verificato/simulato/nessuna commissione
+    => il netto cosi' com'e'. Commissione stimata su una vincita => vincita meno
+    la commissione massima documentata (+ margine). Dati illeggibili => la
+    vincita e' considerata interamente a rischio (0), la perdita resta intera."""
+    try:
+        net = float(net_pnl)
+    except (TypeError, ValueError):
+        return 0.0
+    if not math.isfinite(net):
+        return 0.0
+    if net <= 0.0 or allows_risk_increase(data):
+        return net
+    data = data or {}
+    gross = _num(data, "gross_pnl")
+    if gross is None or "gross_pnl" not in data or gross <= 0.0:
+        return 0.0  # TECNICA_DELEGATA: non si puo' limitare la commissione => vincita a rischio
+    worst = gross * BETFAIR_ITALY_MAX_COMMISSION_PCT / 100.0 + ROUNDING_MARGIN_EUR
+    return max(0.0, min(net, gross - worst))
