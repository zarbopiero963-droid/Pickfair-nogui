+# Owner #426/6131980558 §2 + #426/6141136157 Q5: drawdown assoluto 10 EUR,
+# stop a perdita >= 10.00 (Q3 #426/6141450045). PROPOSTA close02.
+# NB: il cap di esposizione NON e' hardcoded: si usa il cap configurato
+# (`max_open_exposure`); 10 EUR e' il valore della campagna #351
+# (#426/5656005416 P02/P06), da impostare in configurazione.
+OWNER_MAX_DRAWDOWN_EUR = Decimal("10.00")
+
+
+def _exact_decimal(value):
+    """Valore come Decimal esatto (repr del float, nessuna tolleranza).
+    Non finito / non numerico / bool => None (il chiamante nega)."""
+    if isinstance(value, bool):
+        return None
+    try:
+        d = value if isinstance(value, Decimal) else Decimal(repr(value) if isinstance(value, float) else str(value))
+    except (InvalidOperation, ValueError, TypeError):
+        return None
+    return d if d.is_finite() else None
+
+
+def money_sum(*values):
+    """Somma Decimal esatta degli importi canonici (mai somma float, Q3/T7).
+    Un addendo illeggibile/non finito => Decimal('Infinity') (fail-closed)."""
+    total = Decimal(0)
+    for v in values:
+        d = _exact_decimal(v)
+        if d is None:
+            return Decimal("Infinity")
+        total += d
+    return total
+
