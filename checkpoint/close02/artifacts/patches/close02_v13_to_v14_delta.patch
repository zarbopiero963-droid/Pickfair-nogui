diff --git a/core/peak_reconstruction.py b/core/peak_reconstruction.py
new file mode 100644
index 0000000..c8a5bbb
--- /dev/null
+++ b/core/peak_reconstruction.py
@@ -0,0 +1,229 @@
+"""close02 v14 — ricostruzione del picco equity dallo storico Betfair (owner #426,
+15:31 del 13/10/2026, opzione A). PROPOSTA isolata: sola lettura, nessun ordine.
+
+Fonte dati: `AccountAPING/v1.0/getAccountStatement` (documentata):
+  richiesta  {fromRecord, recordCount, itemDateRange{from,to}, includeItem}
+  risposta   {accountStatement: [StatementItem], moreAvailable}
+  StatementItem {refId, itemDate, amount, balance, itemClass, itemClassData, legacyData}
+  `itemDateRange` e' applicato SOLO con includeItem=ALL ⇒ si usa sempre ALL.
+
+Equity: si usa `balance` dell'estratto (saldo del conto dopo ogni movimento, che
+include depositi/prelievi, esiti, commissioni). NON e' il saldo disponibile
+(availableToBetBalance = saldo − esposizione). Scelta conservativa: il picco del
+saldo e' >= del picco del disponibile ⇒ drawdown mai sottostimato.
+
+Esito: `reconstruct(...)` ritorna una PROPOSTA con evidenze, intervallo, fonti,
+calcoli e SHA. Non scrive MAI il picco e non sblocca nulla. Solo `ratify_peak`
+con la ratifica esplicita dell'owner (riferimento + SHA della proposta digitato)
+scrive il picco, mai al ribasso, e lascia comunque la migrazione v13 al suo flusso.
+Storico incompleto/non verificabile/incoerente ⇒ BLOCCATA, nessun valore.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+from datetime import datetime, timezone
+from typing import Any, Callable, Iterable
+
+from core import risk_persistence as rp
+from core.atomic_io import atomic_write_text
+
+SOURCE = "AccountAPING/v1.0/getAccountStatement (includeItem=ALL)"
+TOLERANCE = 0.005
+PAGE_SIZE = 100
+MAX_PAGES = 10000
+
+
+def _sha(obj: Any) -> str:
+    return hashlib.sha256(json.dumps(obj, sort_keys=True, default=str).encode()).hexdigest()
+
+
+def _num(v: Any):
+    if isinstance(v, bool) or not isinstance(v, (int, float)):
+        return None
+    v = float(v)
+    return v if math.isfinite(v) else None
+
+
+def _dt(v: Any):
+    try:
+        d = datetime.fromisoformat(str(v).replace("Z", "+00:00"))
+        return d if d.tzinfo else None
+    except Exception:
+        return None
+
+
+def fetch_pages(call: Callable[[dict], Any], *, date_from: str, date_to: str) -> list:
+    """Sola lettura: pagina getAccountStatement. `call(params)` e' l'unica via di rete
+    (iniettata). Mai altri metodi. Le pagine grezze sono l'evidenza."""
+    pages, start = [], 0
+    for _ in range(MAX_PAGES):
+        params = {"fromRecord": start, "recordCount": PAGE_SIZE, "includeItem": "ALL",
+                  "itemDateRange": {"from": date_from, "to": date_to}}
+        resp = call(dict(params))
+        pages.append({"request": params, "response": resp})
+        items = (resp or {}).get("accountStatement") if isinstance(resp, dict) else None
+        if not isinstance(resp, dict) or not resp.get("moreAvailable") or not items:
+            break
+        start += len(items)
+    return pages
+
+
+def reconstruct(pages: list, *, relevant_from: str, as_of: str, current_balance: Any) -> dict:
+    """Proposta di picco. `relevant_from`: inizio del periodo rilevante (prima attivita'
+    di rischio nota). `current_balance`: saldo del conto (non il disponibile) verificato
+    alla data `as_of`, per il controllo di chiusura della catena."""
+    reasons: list = []
+    items: list = []
+    seen: set = set()
+    expected_start = 0
+    window = None
+    for i, pg in enumerate(pages or []):
+        req, resp = (pg or {}).get("request") or {}, (pg or {}).get("response")
+        if req.get("includeItem") != "ALL":
+            reasons.append(f"pagina_{i}_includeItem_non_ALL")
+        if req.get("fromRecord") != expected_start:
+            reasons.append(f"pagina_{i}_fromRecord_non_contiguo")
+        w = req.get("itemDateRange") or {}
+        window = window or w
+        if w != window:
+            reasons.append(f"pagina_{i}_intervallo_diverso")
+        if not isinstance(resp, dict) or not isinstance(resp.get("accountStatement"), list):
+            reasons.append(f"pagina_{i}_risposta_illeggibile")
+            break
+        batch = resp["accountStatement"]
+        expected_start += len(batch)
+        items.extend(batch)
+        if i == len(pages) - 1 and resp.get("moreAvailable") is not False:
+            reasons.append("storico_troncato_moreAvailable")
+    if not pages:
+        reasons.append("nessuna_pagina")
+    window = window or {}
+    w_from, w_to = _dt(window.get("from")), _dt(window.get("to"))
+    rel, asof = _dt(relevant_from), _dt(as_of)
+    if None in (w_from, w_to, rel, asof):
+        reasons.append("intervallo_non_verificabile")
+    else:
+        if w_from > rel:
+            reasons.append("intervallo_non_copre_periodo_rilevante")  # massimo parziale
+        if w_to < asof:
+            reasons.append("intervallo_non_arriva_alla_data_di_verifica")
+    rows = []
+    for it in items:
+        if not isinstance(it, dict):
+            reasons.append("voce_illeggibile"); continue
+        ref, d, amt, bal = it.get("refId"), _dt(it.get("itemDate")), _num(it.get("amount")), _num(it.get("balance"))
+        if d is None or amt is None or bal is None or not ref:
+            reasons.append(f"voce_incompleta:{ref}"); continue
+        key = (str(ref), it.get("itemDate"), amt, bal)
+        if key in seen:
+            reasons.append(f"voce_duplicata:{ref}"); continue
+        seen.add(key)
+        rows.append({"refId": str(ref), "itemDate": d.isoformat(), "amount": amt, "balance": bal,
+                     "itemClass": it.get("itemClass")})
+    rows.sort(key=lambda r: r["itemDate"])
+    calc = []
+    peak = None
+    if rows:
+        opening = round(rows[0]["balance"] - rows[0]["amount"], 2)
+        peak, prev = opening, opening
+        calc.append({"passo": "saldo_iniziale", "balance": opening})
+        for r in rows:
+            if abs(prev + r["amount"] - r["balance"]) > TOLERANCE:
+                reasons.append(f"catena_incoerente:{r['refId']}")
+            prev = r["balance"]
+            peak = max(peak, r["balance"])
+            calc.append({"refId": r["refId"], "itemDate": r["itemDate"], "amount": r["amount"],
+                         "balance": r["balance"], "picco_corrente": peak})
+        cur = _num(current_balance)
+        if cur is None:
+            reasons.append("saldo_attuale_non_verificabile")
+        elif abs(prev - cur) > TOLERANCE:
+            reasons.append("saldo_finale_diverso_dal_saldo_attuale")
+        elif cur > peak:
+            peak = cur
+    else:
+        reasons.append("storico_vuoto")
+    reasons = sorted(set(reasons))
+    prop = {"metodo": "ricostruzione_estratto_conto", "fonte": SOURCE,
+            "intervallo": {"da": window.get("from"), "a": window.get("to"),
+                           "periodo_rilevante_da": relevant_from, "verifica_al": as_of},
+            "evidenze_sha256": [_sha(p) for p in pages or []],
+            "evidenze_sha256_totale": _sha(pages or []),
+            "voci": len(rows), "calcoli": calc, "saldo_attuale_dichiarato": current_balance,
+            "stato": "BLOCCATA" if reasons else "VERIFICATA_DA_RATIFICARE",
+            "motivi": reasons,
+            "picco_proposto": None if reasons else round(peak, 2),
+            "richiede_ratifica_owner": True}
+    prop["sha256"] = _sha(prop)
+    return prop
+
+
+def _base(db: Any) -> str:
+    return rp._base(db)
+
+
+def save_proposal(db: Any, prop: dict, pages: list) -> str:
+    """Conserva evidenze + proposta (atomico) e audit append-only. Non tocca il rischio."""
+    b = _base(db)
+    if not b:
+        return ""
+    path = f"{b}.peak_reconstruction.{prop['sha256'][:16]}.json"
+    atomic_write_text(path, json.dumps({"proposta": prop, "pagine_grezze": pages}, sort_keys=True, default=str))
+    _audit(db, {"esito": "PROPOSTA_" + prop["stato"], "sha256": prop["sha256"], "file": os.path.basename(path)})
+    return path
+
+
+def _audit(db: Any, rec: dict) -> None:
+    b = _base(db)
+    rec = dict(rec, at=datetime.now(timezone.utc).isoformat())
+    if b:
+        with open(b + ".peak_reconstruction.audit.jsonl", "a", encoding="utf-8") as fh:
+            fh.write(json.dumps(rec, sort_keys=True, default=str) + "\n"); fh.flush(); os.fsync(fh.fileno())
+
+
+def load_proposal(path: str) -> dict:
+    with open(path, encoding="utf-8") as fh:
+        data = json.load(fh)
+    prop = dict(data["proposta"])
+    sha = prop.pop("sha256")
+    if _sha(prop) != sha or _sha(data["pagine_grezze"]) != prop["evidenze_sha256_totale"]:
+        raise ValueError("proposta_o_evidenze_alterate")
+    prop["sha256"] = sha
+    return prop
+
+
+def ratify_peak(db: Any, path: str, *, owner: str, owner_ref: str, sha_digitato: str) -> dict:
+    """Ratifica ESPLICITA dell'owner di una proposta VERIFICATA. Scrive il picco nelle
+    copie mancanti (mai al ribasso). Non tocca registro, risk-stop, daily-loss:
+    lo sblocco resta al flusso di migrazione v13 (operatore + digest)."""
+    try:
+        prop = load_proposal(path)
+    except Exception as exc:
+        return {"ok": False, "motivo": f"proposta_non_verificabile:{type(exc).__name__}"}
+    if not str(owner or "").strip() or not str(owner_ref or "").strip():
+        motivo = "ratifica_owner_mancante"
+    elif sha_digitato != prop["sha256"]:
+        motivo = "sha_non_corrispondente"
+    elif prop["stato"] != "VERIFICATA_DA_RATIFICARE" or prop["picco_proposto"] is None:
+        motivo = "proposta_bloccata:" + ",".join(prop["motivi"])
+    else:
+        motivo = ""
+    if motivo:
+        _audit(db, {"esito": "RATIFICA_RIFIUTATA", "motivo": motivo, "sha256": prop.get("sha256")})
+        return {"ok": False, "motivo": motivo}
+    stored, err = rp.restore_equity_peak_raw(db)
+    if err:
+        _audit(db, {"esito": "RATIFICA_RIFIUTATA", "motivo": err, "sha256": prop["sha256"]})
+        return {"ok": False, "motivo": err}  # copia illeggibile: nessuna sovrascrittura
+    new = max(v for v in (prop["picco_proposto"], stored) if v is not None)
+    _audit(db, {"esito": "RATIFICA_INTENTO", "owner": owner, "owner_ref": owner_ref,
+                "sha256": prop["sha256"], "picco": new, "picco_esistente": stored})
+    payload = json.dumps({"peak": new, "fonte": "ricostruzione_ratificata", "sha256": prop["sha256"]})
+    if rp._peak_file(db):
+        atomic_write_text(rp._peak_file(db), payload)
+    db.save_settings({rp.EQUITY_PEAK_KEY: payload})
+    _audit(db, {"esito": "RATIFICA_COMPLETATA", "sha256": prop["sha256"], "picco": new})
+    return {"ok": True, "motivo": "", "picco": new}
