+    def _record_risk_decision(self, decision: str, reason: str, signal: Optional[dict] = None,
+                              *, origin: str = "", stake: Any = None) -> None:
+        """Record DUREVOLE e osservabile di una decisione di rischio (PROPOSTA close02 v22).
+
+        Ricostruisce valore dei limiti, decisione, origine, versione della config, customer_ref
+        ed esito (L6 AUDIT); il conteggio e l'ultimo rifiuto stanno in ``get_status()`` (L6
+        OBSERVABLE). Una scrittura fallita non cambia la decisione (gia' presa) ma resta
+        contata in ``persist_failures``."""
+        signal = dict(signal or {})
+        state = self.__dict__.setdefault("_risk_decisions", {
+            "rejected_total": 0, "approved_total": 0, "last_rejection": None, "persist_failures": 0})
+        side = str(signal.get("bet_type") or signal.get("signal_type") or signal.get("side") or "").upper()
+        if not origin:
+            origin = "copy" if signal.get("copy_meta") else ("pattern" if signal.get("pattern_meta") else "signal")
+        record = {
+            "event": "RISK_DECISION", "decision": str(decision), "reason": str(reason or ""),
+            "origin": origin, "side": side, "stake": stake if stake is not None else signal.get("stake"),
+            "config_version": self._config_version(),
+            "limits": {k: getattr(getattr(self, "config", None), k, None) for k in self._RISK_DECISION_LIMITS},
+            "ts": datetime.utcnow().isoformat(),
+        }
+        for k in self._RISK_DECISION_FIELDS:
+            record[k] = signal.get(k)
+        if decision == "REJECTED":
+            state["rejected_total"] += 1
+            state["last_rejection"] = {"reason": record["reason"], "origin": origin, "ts": record["ts"]}
+        else:
+            state["approved_total"] += 1
+        try:
+            self.db.insert_audit_event(record)
+        except Exception:
+            state["persist_failures"] += 1
+            logger.exception("Decisione di rischio non persistita (%s, %s)", decision, record["reason"])
+
     def _reject_signal(self, signal: dict, reason: str) -> None:
