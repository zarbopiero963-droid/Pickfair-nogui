+    # PROPOSTA close02 v22 (CL22-AUDIT-DECISION-001): campi del segnale ammessi nel record di
+    # decisione. Whitelist: nessun testo libero del messaggio, nessun token o credenziale.
+    _RISK_DECISION_FIELDS = ("market_id", "selection_id", "price", "customer_ref", "chat_id")
+    _RISK_DECISION_LIMITS = ("max_open_exposure", "max_order_exposure", "max_market_exposure",
+                             "max_event_exposure_abs", "max_drawdown_abs", "max_stake_abs",
+                             "max_single_bet_pct", "max_total_exposure_pct", "max_daily_loss")
+
+    def _config_version(self):
