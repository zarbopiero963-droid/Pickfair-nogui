+    def _signal_optional_and_defaults(self, cfg: RoserpinaConfig) -> None:
+        try:
+            data = self.get_all_settings() or {}
+        except Exception:
+            return  # la lettura illeggibile e' gia' gestita come non verificabile (t80u)
+        if not isinstance(data, dict):
+            return
+        def raw(k, fb):
+            if k in data:
+                return True, data.get(k)
+            if fb and fb in data:
+                return True, data.get(fb)
+            return False, None
+        empty, absent_opt, corrupt = [], [], list(cfg.corrupt_keys or ())
+        for k, fb in self.OPTIONAL_CAPS.items():
+            present, v = raw(k, fb)
+            if not present or v is None:
+                absent_opt.append(k)
+                logger.warning("CONFIG: cap opzionale assente %s (non impostato)", k)
+            elif isinstance(v, str) and v.strip() == "":
+                empty.append(k)
+                logger.warning("CONFIG: cap opzionale VUOTO %s (trattato come non impostato)", k)
+            else:
+                try:
+                    ok = math.isfinite(float(v)) and not isinstance(v, bool)
+                except Exception:
+                    ok = False
+                if not ok and k not in corrupt:
+                    corrupt.append(k)
+                    logger.error("CONFIG: cap opzionale CORROTTO %s: nuovo rischio bloccato", k)
+        defaulted = []
+        for k in self._roserpina_payload(cfg):
+            if k not in data and k not in self.OPTIONAL_CAPS:
+                defaulted.append(k)
+                logger.warning("CONFIG: chiave assente %s: usato il default del codice (non ratificato)", k)
+        cfg.corrupt_keys = tuple(corrupt)
+        cfg.empty_keys = tuple(empty)
+        cfg.absent_optional_keys = tuple(absent_opt)
+        cfg.defaulted_keys = tuple(defaulted)
+
     def _apply_owner_t80u(self, cfg: RoserpinaConfig) -> None:
         try:
             data = self.get_all_settings() or {}
