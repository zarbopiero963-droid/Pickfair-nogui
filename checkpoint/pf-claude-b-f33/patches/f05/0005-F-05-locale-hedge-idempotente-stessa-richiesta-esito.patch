     def wire(self) -> None:
-        """Sottoscrive il consumer di ``CMD_EXECUTE_CASHOUT`` al bus."""
+        """Sottoscrive il consumer di ``CMD_EXECUTE_CASHOUT`` al bus (dopo il recupero delle righe hedge in volo)."""
