# ============================================================
#  Pickfair Market API — Configurazione
# ============================================================

# --- Credenziali Betfair Exchange ----------------------------
BF_USERNAME=tuo_username_betfair
BF_PASSWORD=tua_password_betfair
BF_APP_KEY=tua_app_key            # Trovala su developer.betfair.com

# --- Certificati SSL (richiesti per il login) -----------------
# Percorso ai file .pem nella stessa cartella del progetto
BF_CERT_PEM=client-2048.crt      # o betfair.crt, certificate.pem, ecc.
BF_KEY_PEM=client-2048.key       # o betfair.key, private.pem, ecc.

# --- Database (opzionale: PostgreSQL online) ------------------
# Se vuoto usa SQLite locale (pickfair_markets.db)
DATABASE_URL=
# Esempio Railway: postgresql://postgres:xxx@monorail.proxy.rlwy.net:1234/railway

# --- Sync e Server -------------------------------------------
SYNC_INTERVAL=120          # Secondi tra ogni sincronizzazione (default 2 min)
HOURS_AHEAD=48             # Quante ore in anticipo scaricare gli eventi
API_HOST=0.0.0.0           # Ascolta su tutte le interfacce
API_PORT=8765              # Porta del server REST

# --- Sport (IDs Betfair) -------------------------------------
# 1=Soccer, 2=Tennis, 4=Cricket, 6=BoxingFight, ecc.
EVENT_TYPE_IDS=1

# --- File DB locale (usato solo se DATABASE_URL e' vuoto) ----
DB_FILE=pickfair_markets.db
