name: Auto PR Codex Supervisor

"on":
  workflow_dispatch:
    inputs:
      pr_number:
        description: "PR number to supervise"
        required: true
        type: string
      max_reruns:
        description: "Maximum Auto PR Codex Fix reruns"
        required: false
        default: "3"
        type: string
  workflow_run:
    workflows: ["Auto PR Codex Fix"]
    types: [completed]

permissions:
  actions: write
  contents: read
  pull-requests: read
  checks: read
  statuses: read

concurrency:
  group: auto-pr-codex-supervisor-${{ github.event.inputs.pr_number || github.event.workflow_run.id || github.run_id }}
  cancel-in-progress: false

jobs:
  supervise:
    name: Rerun Auto PR Codex Fix if blockers remain
    runs-on: self-hosted
    if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'failure' }}

    env:
      GH_TOKEN: ${{ secrets.PICKFAIR_ACTIONS_TOKEN }}
      GITHUB_TOKEN: ${{ secrets.PICKFAIR_ACTIONS_TOKEN }}
      SOURCE_RUN_ID: ${{ github.event.workflow_run.id || '' }}
      INPUT_PR_NUMBER: ${{ github.event.inputs.pr_number || '' }}
      MAX_RERUNS: ${{ github.event.inputs.max_reruns || '3' }}

    steps:
      - name: Resolve PR number
        id: pr
        run: |
          set -euo pipefail

          PR_NUMBER="${INPUT_PR_NUMBER:-}"

          if [ -z "$PR_NUMBER" ] && [ -n "${SOURCE_RUN_ID:-}" ]; then
            echo "Resolving PR number from Auto PR Codex Fix artifacts for run $SOURCE_RUN_ID"

            PR_NUMBER="$(
              gh api "repos/${GITHUB_REPOSITORY}/actions/runs/${SOURCE_RUN_ID}/artifacts" \
                --jq '.artifacts[].name' \
              | sed -n 's/^auto-pr-codex-fix-logs-\([0-9][0-9]*\)$/\1/p' \
              | head -n 1
            )"
          fi

          if [ -z "$PR_NUMBER" ]; then
            echo "::error::Could not resolve PR number."
            exit 1
          fi

          echo "pr_number=$PR_NUMBER" >> "$GITHUB_OUTPUT"
          echo "PR_NUMBER=$PR_NUMBER"

      - name: Check PR blockers
        id: blockers
        env:
          PR_NUMBER: ${{ steps.pr.outputs.pr_number }}
        run: |
          set -euo pipefail
          mkdir -p supervisor-output

          gh pr view "$PR_NUMBER" \
            --json headRefOid,statusCheckRollup \
            --jq '.headRefOid' \
            > supervisor-output/head-sha.txt

          HEAD_SHA="$(cat supervisor-output/head-sha.txt)"

          gh pr view "$PR_NUMBER" --json statusCheckRollup \
            --jq '.statusCheckRollup[]?
              | {
                  name: (.name // .context // ""),
                  state: (.conclusion // .state // .status // ""),
                  url: (.detailsUrl // .targetUrl // "")
                }
              | select(.state != "SUCCESS" and .state != "SKIPPED" and .state != "NEUTRAL" and .state != "CANCELLED")
              | select((.name | test("Auto PR Codex Fix|Auto PR Codex Supervisor")) | not)' \
            > supervisor-output/blocking-checks.jsonl

          QUERY='query($owner:String!, $repo:String!, $number:Int!) { repository(owner:$owner, name:$repo) { pullRequest(number:$number) { reviewThreads(first:100) { nodes { isResolved path line comments(first:20) { nodes { author { login } body createdAt url } } } } } } }'

          gh api graphql \
            -f owner="${GITHUB_REPOSITORY_OWNER}" \
            -f repo="${GITHUB_REPOSITORY#*/}" \
            -F number="$PR_NUMBER" \
            -f query="$QUERY" \
            | jq -c '.data.repository.pullRequest.reviewThreads.nodes[]?
              | select(.isResolved == false)
              | {
                  path,
                  line,
                  comments: [
                    .comments.nodes[] | {
                      author: .author.login,
                      createdAt,
                      url,
                      body
                    }
                  ]
                }' \
            > supervisor-output/unresolved-review-threads.jsonl

          BLOCKING_CHECKS_COUNT="$(wc -l < supervisor-output/blocking-checks.jsonl | tr -d ' ')"
          UNRESOLVED_REVIEW_COUNT="$(wc -l < supervisor-output/unresolved-review-threads.jsonl | tr -d ' ')"

          echo "head_sha=$HEAD_SHA" >> "$GITHUB_OUTPUT"
          echo "blocking_checks_count=$BLOCKING_CHECKS_COUNT" >> "$GITHUB_OUTPUT"
          echo "unresolved_review_count=$UNRESOLVED_REVIEW_COUNT" >> "$GITHUB_OUTPUT"

          echo "Head SHA: $HEAD_SHA"
          echo "Blocking checks: $BLOCKING_CHECKS_COUNT"
          echo "Unresolved review threads: $UNRESOLVED_REVIEW_COUNT"

          if [ "$BLOCKING_CHECKS_COUNT" -gt 0 ]; then
            echo "Blocking checks:"
            cat supervisor-output/blocking-checks.jsonl
          fi

          if [ "$UNRESOLVED_REVIEW_COUNT" -gt 0 ]; then
            echo "Unresolved review threads:"
            cat supervisor-output/unresolved-review-threads.jsonl
          fi

      - name: Stop if no blockers
        if: steps.blockers.outputs.blocking_checks_count == '0' && steps.blockers.outputs.unresolved_review_count == '0'
        run: |
          echo "No blockers remain. Supervisor will not rerun Auto PR Codex Fix."

      - name: Guard max reruns
        id: guard
        if: steps.blockers.outputs.blocking_checks_count != '0' || steps.blockers.outputs.unresolved_review_count != '0'
        env:
          PR_NUMBER: ${{ steps.pr.outputs.pr_number }}
          HEAD_SHA: ${{ steps.blockers.outputs.head_sha }}
        run: |
          set -euo pipefail

          STATE_DIR="$HOME/pickfair-auto-state/supervisor/pr-$PR_NUMBER"
          mkdir -p "$STATE_DIR"

          COUNT_FILE="$STATE_DIR/${HEAD_SHA}.reruns"
          CURRENT_COUNT="0"

          if [ -f "$COUNT_FILE" ]; then
            CURRENT_COUNT="$(cat "$COUNT_FILE" | tr -dc '0-9' || true)"
            CURRENT_COUNT="${CURRENT_COUNT:-0}"
          fi

          echo "Current supervisor reruns for PR $PR_NUMBER head $HEAD_SHA: $CURRENT_COUNT"
          echo "Max reruns: $MAX_RERUNS"

          if [ "$CURRENT_COUNT" -ge "$MAX_RERUNS" ]; then
            echo "::error::Max supervisor reruns reached for PR $PR_NUMBER head $HEAD_SHA."
            echo "should_rerun=false" >> "$GITHUB_OUTPUT"
            exit 1
          fi

          NEXT_COUNT="$((CURRENT_COUNT + 1))"
          echo "$NEXT_COUNT" > "$COUNT_FILE"

          echo "should_rerun=true" >> "$GITHUB_OUTPUT"
          echo "next_count=$NEXT_COUNT" >> "$GITHUB_OUTPUT"

      - name: Rerun Auto PR Codex Fix
        if: steps.guard.outputs.should_rerun == 'true'
        env:
          PR_NUMBER: ${{ steps.pr.outputs.pr_number }}
        run: |
          set -euo pipefail

          echo "Rerunning Auto PR Codex Fix for PR #$PR_NUMBER"
          echo "Supervisor rerun number: ${{ steps.guard.outputs.next_count }}"

          gh workflow run auto-pr-codex-fix.yml \
            -f pr_number="$PR_NUMBER" \
            -f force=true \
            -f dry_run=false
