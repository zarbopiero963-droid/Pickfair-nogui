# Operatore di deploy (ruolo 4): installa SOLO artefatti verificati del catalogo, via unita predefinite. %i = id operazione del catalogo (validato dal controllore).
[Unit]
Description=Pickfair VPS bridge - deploy %i
[Service]
Type=oneshot
User=pf-bridge-deploy
Group=pf-bridge-deploy
ExecStart=/usr/bin/python3 -I /opt/pf-bridge/current/bridge/deploy.py --op %i
PrivateNetwork=yes
ReadWritePaths=/opt/pf-bridge/releases /var/lib/pf-bridge/audit
TimeoutStartSec=900
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
InaccessiblePaths=-/etc/pf-livekey-vault -/root/.ssh -/etc/ssh
ReadOnlyPaths=/opt/pf-bridge
